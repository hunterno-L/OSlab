# 容器内初始化脚本必须保持 LF，Windows 检出时不得转成 CRLF
deploy/mysql-init/*.sh text eol=lf

# 脚本、SQL、Node 工具统一 LF，保证 Linux/容器/Docker 构建一致
*.sh text eol=lf
*.sql text eol=lf
*.mjs text eol=lf

# 部署包内文本固定 LF，保证 SHA256SUMS 在 Windows 检出后仍可校验
deploy/database-20261028/*.cypher text eol=lf
deploy/database-20261028/*.md text eol=lf
deploy/database-20261028/*.json text eol=lf
deploy/database-20261028/SHA256SUMS text eol=lf
deploy/database-20261028/*.gz binary

# 内核实验：xv6 源码在 WSL/Linux 里编译，换行必须 LF（Makefile 混入 CR 会直接编译失败）
**/xv6-riscv/** text eol=lf
内核实验/** text eol=lf
