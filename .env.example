# 本机开发模板：复制为仓库根目录 .env，再填写实际连接信息。
# start-oslab.ps1 自动读取；已有进程环境变量优先。值不执行脚本或变量展开。
SPRING_PROFILES_ACTIVE=dev
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8121

SPRING_DATASOURCE_URL='jdbc:mysql://localhost:3306/oslab_db?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai'
SPRING_DATASOURCE_USERNAME=oslab_app
SPRING_DATASOURCE_PASSWORD=replace-with-your-local-mysql-password
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_DATABASE=1
SPRING_REDIS_PASSWORD=
SPRING_REDIS_TIMEOUT=5s
SPRING_NEO4J_URI=bolt://localhost:7687
SPRING_NEO4J_AUTHENTICATION_USERNAME=neo4j
SPRING_NEO4J_AUTHENTICATION_PASSWORD=replace-with-your-local-neo4j-password
SPRING_ELASTICSEARCH_URIS=http://localhost:9200
SPRING_ELASTICSEARCH_USERNAME=
SPRING_ELASTICSEARCH_PASSWORD=

# 手动 npm run serve 时使用；Windows 启动脚本按实际后端端口设置代理。
VUE_APP_API_TARGET=http://localhost:8121
OSLAB_LEARNING_ENABLED_COURSES=course.operating-systems
OSLAB_TASK_STORAGE_DIR=./data/task-files
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# 个人模型密钥的持久加密主密钥。使用独立的长随机值，后续不要随意更换。
OSLAB_AI_MASTER_KEY=
AI_ARK_API_KEY=
AI_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_ARK_MODEL=deepseek-v3-250324
AI_ARK_EMBEDDING_MODEL=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_ALLOW_PRIVATE_BASE_URL=false
AI_CONNECT_TIMEOUT_MS=5000
AI_REQUEST_TIMEOUT_MS=30000
AI_TURN_POOL_SIZE=2
AI_TURN_QUEUE_CAPACITY=32
AI_TURN_MAX_TOOL_CALLS=3
AI_TURN_MAX_MODEL_CALLS=2
AI_TURN_ANSWER_MAX_TOKENS=4096
AI_TURN_PLAN_MAX_TOKENS=2048
AI_RETRIEVAL_MAX_SOURCES=8
AI_RETRIEVAL_SEMANTIC_CANDIDATES=200
AI_RETRIEVAL_KEYWORD_CANDIDATES=60
AI_MATERIAL_MAX_CHARS=20000
AI_MATERIAL_MAX_COUNT=20
AI_CHUNK_TARGET_CHARS=700

# 未配置真实沙箱时保持 URL 为空，提交会如实失败；不要改为示例判题器。
CODESANDBOX_TYPE=remote
CODESANDBOX_REMOTE_URL=
CODESANDBOX_REMOTE_AUTH_SECRET=
CODESANDBOX_REMOTE_TIMEOUT_MS=30000

# 可选对象存储；任务私有附件使用上面的本地 storage-dir。
COS_ACCESS_KEY=
COS_SECRET_KEY=
COS_REGION=ap-beijing
COS_BUCKET=
