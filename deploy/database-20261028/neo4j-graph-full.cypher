CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '操作系统为每个进程设置的数据结构，记录进程标识、状态、资源清单和 CPU 现场；PCB 是进程存在的唯一标志。', `displayName`: '进程控制块', `homeSectionCode`: 'sec.process.process-composition', `label`: '基础', `layer`: 'CORE', `name`: '进程控制块', `nodeCode`: 'os.process.pcb', `nodeType`: 'CONCEPT', `__oslab_export_id`: 77});
