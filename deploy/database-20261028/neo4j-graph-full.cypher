CREATE CONSTRAINT `course_entity_node_code` IF NOT EXISTS FOR (n:`Entity`) REQUIRE n.`nodeCode` IS UNIQUE;

CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '当内存不足发生缺页时，按某种算法选择一个内存页换出，为调入页腾出物理块。常见算法有 FIFO、LRU、OPT 等，评价指标是缺页率。', `label`: '概念', `name`: '页面置换', `__oslab_export_id`: 0});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '先进先出（FIFO）页面置换算法：淘汰最早进入内存的页面。实现简单（队列），但可能出现 Belady 异常——物理块增多缺页反而上升。', `label`: '概念', `name`: 'FIFO', `__oslab_export_id`: 1});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '最近最久未使用（LRU）页面置换算法：淘汰最长时间未被访问的页面，利用了局部性原理。关键规则：命中后也要更新该页的最近访问顺序。', `label`: '概念', `name`: 'LRU 页面置换算法', `__oslab_export_id`: 2});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '进程生命周期中的状态（五状态模型）：创建、就绪、运行、阻塞、终止。运行态因时间片用完转就绪态，因等待事件转阻塞态。', `label`: '概念', `name`: '进程状态', `__oslab_export_id`: 3});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: 'CPU 调度（处理机调度）按一定算法从就绪队列中选择进程获得 CPU，常见算法有 FCFS、SJF、RR（时间片轮转）等，评价指标包括周转时间、等待时间。', `label`: '概念', `name`: 'CPU 调度', `__oslab_export_id`: 4});
CREATE (n:`Entity` {`chapter`: '计算机系统概述', `courseProjection`: true, `description`: '最基本的系统软件，负责统筹硬件、软件资源和计算机工作，并向用户及其他软件提供接口与环境。', `displayName`: '操作系统', `homeSectionCode`: 'sec.overview.basic-concepts', `label`: '基础', `layer`: 'CORE', `name`: '操作系统', `nodeCode`: 'os.overview.operating_system', `nodeType`: 'CONCEPT', `__oslab_export_id`: 5});
CREATE (n:`Entity` {`chapter`: '内存管理', `name`: '缺页中断', `__oslab_export_id`: 6});
