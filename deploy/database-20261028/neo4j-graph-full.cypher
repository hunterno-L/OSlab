CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '通信进程通过一块可直接访问的共享空间读写数据；操作系统提供共享空间和同步互斥工具，数据交换由用户程序完成。', `displayName`: '共享存储通信', `homeSectionCode`: 'sec.process.ipc', `label`: '进阶', `layer`: 'CORE', `name`: '共享存储通信', `nodeCode`: 'os.process.shared_memory', `nodeType`: 'MECHANISM', `__oslab_export_id`: 81});
