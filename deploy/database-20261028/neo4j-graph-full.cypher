CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '系统中没有就绪进程时运行的内核进程，PID 为 0，优先级最低，不消耗 CPU 以外的资源且不会被阻塞。', `displayName`: '闲逛进程', `homeSectionCode`: 'sec.process.scheduling-implementation', `label`: '基础', `layer`: 'CORE', `name`: '闲逛进程', `nodeCode`: 'os.cpu.idle_process', `nodeType`: 'CONCEPT', `__oslab_export_id`: 90});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '评价 CPU 调度算法的常用指标：CPU 利用率、系统吞吐量、周转时间、带权周转时间、等待时间和响应时间。', `displayName`: '调度评价指标', `homeSectionCode`: 'sec.process.scheduling-goals', `label`: '基础', `layer`: 'CORE', `name`: '调度评价指标', `nodeCode`: 'os.cpu.scheduling_metrics', `nodeType`: 'CONCEPT', `__oslab_export_id`: 91});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '保存当前进程的 CPU 现场到其 PCB，并装入被调度进程的现场；与不改变当前进程的模式切换不同，只能发生在内核态。', `displayName`: '上下文切换', `homeSectionCode`: 'sec.process.context-switch', `label`: '进阶', `layer`: 'CORE', `name`: '上下文切换', `nodeCode`: 'os.cpu.context_switch', `nodeType`: 'MECHANISM', `__oslab_export_id`: 92});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '设置多个就绪队列，把不同类型或性质的进程固定分配到不同队列，各队列可采用不同调度算法和优先级。', `displayName`: '多级队列调度算法', `homeSectionCode`: 'sec.process.cpu-algorithms', `label`: '进阶', `layer`: 'CORE', `name`: '多级队列调度算法', `nodeCode`: 'os.cpu.mlq', `nodeType`: 'ALGORITHM', `__oslab_export_id`: 93});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '一次仅允许一个进程使用的资源称为临界资源；进程中访问临界资源的那段代码称为临界区，访问过程分为进入区、临界区、退出区和剩余区。', `displayName`: '临界资源与临界区', `homeSectionCode`: 'sec.process.sync-concept', `label`: '基础', `layer`: 'CORE', `name`: '临界资源与临界区', `nodeCode`: 'os.process.critical_section', `nodeType`: 'CONCEPT', `__oslab_export_id`: 94});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '同步（直接制约）源于进程合作，要求进程按一定次序推进；互斥（间接制约）源于共享临界资源，同一时刻只允许一个进程进入临界区。同步机制应满足空闲让进、忙则等待、有限等待和让权等待。', `displayName`: '进程同步与互斥', `homeSectionCode`: 'sec.process.sync-concept', `label`: '基础', `layer`: 'CORE', `name`: '进程同步与互斥', `nodeCode`: 'os.process.synchronization', `nodeType`: 'CONCEPT', `__oslab_export_id`: 95});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '在进入区设置并检查标志来实现临界区互斥，包括单标志法、双标志先检查法、双标志后检查法和 Peterson 算法。', `displayName`: '实现互斥的软件方法', `homeSectionCode`: 'sec.process.sync-methods', `label`: '进阶', `layer`: 'CORE', `name`: '实现互斥的软件方法', `nodeCode`: 'os.process.software_mutex', `nodeType`: 'ALGORITHM', `__oslab_export_id`: 96});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '用 flag 数组表示进入意愿、用 turn 表示谦让对象；同时检测对方 flag 与 turn，保证互斥并避免饥饿，但仍不满足让权等待。', `displayName`: 'Peterson 算法', `homeSectionCode`: 'sec.process.sync-methods', `label`: '进阶', `layer`: 'CORE', `name`: 'Peterson 算法', `nodeCode`: 'os.process.peterson', `nodeType`: 'ALGORITHM', `__oslab_export_id`: 97});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '通过关中断、TestAndSet 指令或 Swap 指令，把检查与修改锁的操作做成原子动作，从而实现临界区互斥。', `displayName`: '实现互斥的硬件方法', `homeSectionCode`: 'sec.process.sync-methods', `label`: '进阶', `layer`: 'CORE', `name`: '实现互斥的硬件方法', `nodeCode`: 'os.process.hardware_mutex', `nodeType`: 'MECHANISM', `__oslab_export_id`: 98});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '互斥锁用布尔变量 available 表示锁状态，进入临界区前 acquire、退出后 release；忙等待的实现称为自旋锁，适合上锁时间短的多处理器系统。', `displayName`: '互斥锁与自旋锁', `homeSectionCode`: 'sec.process.mutex-lock', `label`: '进阶', `layer`: 'CORE', `name`: '互斥锁与自旋锁', `nodeCode`: 'os.process.mutex_lock', `nodeType`: 'MECHANISM', `__oslab_export_id`: 99});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '信号量是只能被 wait(P) 和 signal(V) 两个原语访问的变量；整型信号量忙等，记录型信号量增加等待队列并用 block/wakeup 实现让权等待。', `displayName`: '信号量机制', `homeSectionCode`: 'sec.process.semaphore', `label`: '进阶', `layer`: 'CORE', `name`: '信号量机制', `nodeCode`: 'os.process.semaphore', `nodeType`: 'MECHANISM', `__oslab_export_id`: 100});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '用互斥信号量夹紧临界区实现互斥；用初值为 0 的同步信号量，在前驱行为后 V、后继行为前 P 实现同步与前驱关系。', `displayName`: 'PV 操作的同步互斥用法', `homeSectionCode`: 'sec.process.semaphore', `label`: '进阶', `layer`: 'CORE', `name`: 'PV 操作的同步互斥用法', `nodeCode`: 'os.process.pv_operation', `nodeType`: 'ALGORITHM', `__oslab_export_id`: 101});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '生产者与消费者共享大小为 n 的缓冲区，用 mutex 保护缓冲区、empty 和 full 记录空/满单元数；对 empty/full 的 P 操作必须先于 P(mutex)。', `displayName`: '生产者-消费者问题', `homeSectionCode`: 'sec.process.classic-sync', `label`: '进阶', `layer`: 'CORE', `name`: '生产者-消费者问题', `nodeCode`: 'os.process.producer_consumer', `nodeType`: 'ALGORITHM', `__oslab_export_id`: 102});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '允许多个读者同时读、写者与其他进程互斥；用 count 统计读者数、mutex 保护 count、rw 控制读写互斥，可增加 w 信号量实现相对写优先。', `displayName`: '读者-写者问题', `homeSectionCode`: 'sec.process.classic-sync', `label`: '进阶', `layer`: 'CORE', `name`: '读者-写者问题', `nodeCode`: 'os.process.reader_writer', `nodeType`: 'ALGORITHM', `__oslab_export_id`: 103});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '5 名哲学家交替思考和进餐，进餐需同时取得左右两根筷子；朴素算法在同时拿起左筷时死锁，可用限制人数、一次取两根或奇偶编号规则避免。', `displayName`: '哲学家进餐问题', `homeSectionCode`: 'sec.process.classic-sync', `label`: '进阶', `layer`: 'CORE', `name`: '哲学家进餐问题', `nodeCode`: 'os.process.philosopher', `nodeType`: 'ALGORITHM', `__oslab_export_id`: 104});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '一个供应者轮流在桌上放两种材料，拥有第三种材料的吸烟者取得材料、卷烟并抽掉，抽完后通知供应者继续；用三个 offer 信号量加 finish 信号量协调。', `displayName`: '吸烟者问题', `homeSectionCode`: 'sec.process.classic-sync', `label`: '进阶', `layer`: 'CORE', `name`: '吸烟者问题', `nodeCode`: 'os.process.smoker', `nodeType`: 'ALGORITHM', `__oslab_export_id`: 105});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '管程把共享数据结构及对其操作的一组过程封装起来，每次只允许一个进程进入，从而自动保证互斥；由名称、共享数据结构、操作过程和初始化语句组成。', `displayName`: '管程', `homeSectionCode`: 'sec.process.monitor', `label`: '进阶', `layer`: 'CORE', `name`: '管程', `nodeCode`: 'os.process.monitor', `nodeType`: 'MECHANISM', `__oslab_export_id`: 106});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '管程内用于描述阻塞原因的条件变量，只能执行 wait（释放管程并排队等待）和 signal（唤醒一个等待进程）；它没有值，剩余资源数由共享数据结构记录。', `displayName`: '条件变量', `homeSectionCode`: 'sec.process.monitor', `label`: '基础', `layer`: 'CORE', `name`: '条件变量', `nodeCode`: 'os.process.condition_variable', `nodeType`: 'CONCEPT', `__oslab_export_id`: 107});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '多个进程因竞争资源而互相等待对方持有的资源，若无外力干涉，所有相关进程都无法推进。死锁与饥饿都使进程无法推进，但死锁至少涉及两个进程且都处于阻塞态。', `displayName`: '死锁', `homeSectionCode`: 'sec.process.deadlock-concept', `label`: '基础', `layer`: 'CORE', `name`: '死锁', `nodeCode`: 'os.process.deadlock', `nodeType`: 'CONCEPT', `__oslab_export_id`: 108});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '死锁必须同时满足互斥、不可剥夺、请求并保持和循环等待四个条件；任一条件不成立就不会死锁。循环等待只是必要条件，同类资源多于一个时资源分配图有圈未必死锁。', `displayName`: '死锁产生的必要条件', `homeSectionCode`: 'sec.process.deadlock-conditions', `label`: '基础', `layer`: 'CORE', `name`: '死锁产生的必要条件', `nodeCode`: 'os.process.deadlock_conditions', `nodeType`: 'CONCEPT', `__oslab_export_id`: 109});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '死锁处理分为预防、避免、检测与解除三类：预防破坏必要条件，避免在分配时防止进入不安全状态，检测与解除则允许死锁发生后发现并恢复。', `displayName`: '死锁处理策略', `homeSectionCode`: 'sec.process.deadlock-strategy', `label`: '基础', `layer`: 'CORE', `name`: '死锁处理策略', `nodeCode`: 'os.process.deadlock_strategy', `nodeType`: 'CONCEPT', `__oslab_export_id`: 110});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '通过破坏互斥、不可剥夺、请求并保持或循环等待四个必要条件之一来防止死锁；常用手段有资源预先静态分配、释放已占资源后重新申请和顺序资源分配法。', `displayName`: '死锁预防', `homeSectionCode`: 'sec.process.deadlock-prevention', `label`: '进阶', `layer`: 'CORE', `name`: '死锁预防', `nodeCode`: 'os.process.deadlock_prevention', `nodeType`: 'ALGORITHM', `__oslab_export_id`: 111});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '若系统能按某种进程推进顺序为每个进程分配其所需资源直至全部完成，则该顺序为安全序列，系统处于安全状态；找不到安全序列即为不安全状态。安全状态一定不死锁，不安全状态可能死锁。', `displayName`: '系统安全状态', `homeSectionCode`: 'sec.process.deadlock-avoidance', `label`: '基础', `layer`: 'CORE', `name`: '系统安全状态', `nodeCode`: 'os.process.safe_state', `nodeType`: 'CONCEPT', `__oslab_export_id`: 112});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '最著名的死锁避免算法：进程预先声明最大需求，每次请求时先检查 Request≤Need 和 Request≤Available，再试分配并执行安全性算法，只有新状态安全才正式分配。', `displayName`: '银行家算法', `homeSectionCode`: 'sec.process.deadlock-banker', `label`: '进阶', `layer`: 'CORE', `name`: '银行家算法', `nodeCode`: 'os.process.banker', `nodeType`: 'ALGORITHM', `__oslab_export_id`: 113});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '用资源分配图描述进程与资源的请求/分配关系，通过反复消去不阻塞进程的边来化简图；状态 S 死锁当且仅当其资源分配图不可完全简化（死锁定理）。', `displayName`: '死锁检测', `homeSectionCode`: 'sec.process.deadlock-detection', `label`: '进阶', `layer`: 'CORE', `name`: '死锁检测', `nodeCode`: 'os.process.deadlock_detection', `nodeType`: 'ALGORITHM', `__oslab_export_id`: 114});
CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '检测到死锁后可用资源剥夺法、撤销进程法或进程回退法解除；资源剥夺可能使被挂起进程资源匮乏，撤销进程代价可能很大，回退需要保存历史信息和还原点。', `displayName`: '死锁解除', `homeSectionCode`: 'sec.process.deadlock-detection', `label`: '进阶', `layer`: 'CORE', `name`: '死锁解除', `nodeCode`: 'os.process.deadlock_recovery', `nodeType`: 'ALGORITHM', `__oslab_export_id`: 115});
CREATE (n:`Entity` {`chapter`: '内存管理', `courseProjection`: true, `description`: '操作系统对内存空间的划分和动态分配；主要功能包括分配与回收、地址转换、空间扩充、共享和保护。', `displayName`: '内存管理', `homeSectionCode`: 'sec.memory.basic', `label`: '基础', `layer`: 'CORE', `name`: '内存管理', `nodeCode`: 'os.memory.memory_management', `nodeType`: 'CONCEPT', `__oslab_export_id`: 116});
CREATE (n:`Entity` {`chapter`: '内存管理', `courseProjection`: true, `description`: '把用户源程序变为可在内存中执行的程序的过程，包括编译、链接和装入；装入方式分为绝对装入、可重定位装入和动态运行时装入。', `displayName`: '程序的链接与装入', `homeSectionCode`: 'sec.memory.basic', `label`: '进阶', `layer`: 'CORE', `name`: '程序的链接与装入', `nodeCode`: 'os.memory.loading_linking', `nodeType`: 'MECHANISM', `__oslab_export_id`: 117});
CREATE (n:`Entity` {`chapter`: '内存管理', `courseProjection`: true, `description`: '逻辑地址是程序使用的相对地址，物理地址是内存单元的最终地址；两者通过地址重定位和 MMU 转换。', `displayName`: '逻辑地址与物理地址', `homeSectionCode`: 'sec.memory.basic', `label`: '基础', `layer`: 'CORE', `name`: '逻辑地址与物理地址', `nodeCode`: 'os.memory.logical_address', `nodeType`: 'CONCEPT', `__oslab_export_id`: 118});
CREATE (n:`Entity` {`chapter`: '内存管理', `courseProjection`: true, `description`: '程序调入内存运行后形成的映像，通常由代码段、数据段、PCB、堆和栈等部分组成。', `displayName`: '进程内存映像', `homeSectionCode`: 'sec.memory.basic', `label`: '基础', `layer`: 'CORE', `name`: '进程内存映像', `nodeCode`: 'os.memory.process_image', `nodeType`: 'CONCEPT', `__oslab_export_id`: 119});
CREATE (n:`Entity` {`chapter`: '内存管理', `courseProjection`: true, `description`: '保证各进程在自己的存储空间内运行、互不干扰；可用上/下限寄存器，或用重定位寄存器与界地址寄存器配合越界检查。', `displayName`: '内存保护', `homeSectionCode`: 'sec.memory.basic', `label`: '进阶', `layer`: 'CORE', `name`: '内存保护', `nodeCode`: 'os.memory.protection', `nodeType`: 'MECHANISM', `__oslab_export_id`: 120});
CREATE (n:`Entity` {`chapter`: '内存管理', `courseProjection`: true, `description`: '多个进程访问内存的同一部分；只有只读的可重入代码适合共享，可写部分需复制到各进程的私有数据区。', `displayName`: '内存共享', `homeSectionCode`: 'sec.memory.basic', `label`: '进阶', `layer`: 'CORE', `name`: '内存共享', `nodeCode`: 'os.memory.sharing', `nodeType`: 'MECHANISM', `__oslab_export_id`: 121});
CREATE (n:`Entity` {`chapter`: '内存管理', `courseProjection`: true, `description`: '把用户内存划分为若干固定大小的分区，每个分区装入一道作业；分区大小可相等或不等，会产生内部碎片。', `displayName`: '固定分区分配', `homeSectionCode`: 'sec.memory.contiguous', `label`: '进阶', `layer`: 'CORE', `name`: '固定分区分配', `nodeCode`: 'os.memory.fixed_partition', `nodeType`: 'MECHANISM', `__oslab_export_id`: 122});
CREATE (n:`Entity` {`chapter`: '内存管理', `courseProjection`: true, `description`: '进程装入时按实际需要动态划分分区，分区大小和数量可变；会产生外部碎片，可用紧凑技术合并。', `displayName`: '动态分区分配', `homeSectionCode`: 'sec.memory.contiguous', `label`: '进阶', `layer`: 'CORE', `name`: '动态分区分配', `nodeCode`: 'os.memory.dynamic_partition', `nodeType`: 'MECHANISM', `__oslab_export_id`: 123});
CREATE (n:`Entity` {`chapter`: '内存管理', `courseProjection`: true, `description`: '把内存划分为固定大小的页框、把进程逻辑空间划分为同样大小的页，以页框为单位离散分配；通过页表实现页号到块号的映射。', `displayName`: '基本分页存储管理', `homeSectionCode`: 'sec.memory.paging', `label`: '进阶', `layer`: 'CORE', `name`: '基本分页存储管理', `nodeCode`: 'os.memory.paging', `nodeType`: 'MECHANISM', `__oslab_export_id`: 124});
CREATE (n:`Entity` {`chapter`: '内存管理', `courseProjection`: true, `description`: '对页表本身再分页并建立外层页表（页目录），使页表可以离散存放、按需调入，解决大地址空间下页表过大且必须连续的问题。', `displayName`: '多级页表', `homeSectionCode`: 'sec.memory.paging', `label`: '进阶', `layer`: 'CORE', `name`: '多级页表', `nodeCode`: 'os.memory.multilevel_page_table', `nodeType`: 'MECHANISM', `__oslab_export_id`: 125});
CREATE (n:`Entity` {`chapter`: '内存管理', `courseProjection`: true, `description`: '按程序逻辑关系把地址空间划分为大小不等的段，段内连续、段间可不连续；通过段表记录段长和基址，地址空间是二维的。', `displayName`: '基本分段存储管理', `homeSectionCode`: 'sec.memory.segmentation', `label`: '进阶', `layer`: 'CORE', `name`: '基本分段存储管理', `nodeCode`: 'os.memory.segmentation', `nodeType`: 'MECHANISM', `__oslab_export_id`: 126});
CREATE (n:`Entity` {`chapter`: '内存管理', `courseProjection`: true, `description`: '先按逻辑分段，再把每段分成固定大小的页；地址由段号、页号和页内偏移组成，每进程一张段表、每段一张页表。', `displayName`: '段页式存储管理', `homeSectionCode`: 'sec.memory.segment-paging', `label`: '进阶', `layer`: 'CORE', `name`: '段页式存储管理', `nodeCode`: 'os.memory.segment_paging', `nodeType`: 'MECHANISM', `__oslab_export_id`: 127});
CREATE (n:`Entity` {`chapter`: '内存管理', `courseProjection`: true, `description`: '按空闲分区大小分类并建立索引表来加速查找，包括快速适应、伙伴系统和哈希算法。', `displayName`: '空闲分区索引分配算法', `homeSectionCode`: 'sec.memory.contiguous', `label`: '进阶', `layer`: 'CORE', `name`: '空闲分区索引分配算法', `nodeCode`: 'os.memory.indexed_allocation', `nodeType`: 'ALGORITHM', `__oslab_export_id`: 128});
CREATE (n:`Entity` {`chapter`: '内存管理', `courseProjection`: true, `description`: '规定分区大小均为 2 的幂；分配时在相应大小链表中查找，找不到就把更大的分区对半分割，回收时合并伙伴分区。', `displayName`: '伙伴系统', `homeSectionCode`: 'sec.memory.contiguous', `label`: '进阶', `layer`: 'CORE', `name`: '伙伴系统', `nodeCode`: 'os.memory.buddy_system', `nodeType`: 'ALGORITHM', `__oslab_export_id`: 129});
CREATE (n:`Entity` {`chapter`: '内存管理', `courseProjection`: true, `description`: '在基本分页基础上增加请求调页和页面置换功能，只装入当前需要的部分页面便可启动作业；由请求页表项、缺页中断机构和地址变换机构共同支撑。', `displayName`: '请求分页存储管理', `homeSectionCode`: 'sec.memory.demand-paging', `label`: '进阶', `layer`: 'CORE', `name`: '请求分页存储管理', `nodeCode`: 'os.memory.demand_paging', `nodeType`: 'MECHANISM', `__oslab_export_id`: 130});
CREATE (n:`Entity` {`chapter`: '内存管理', `courseProjection`: true, `description`: '操作系统分配给一个进程的页框集合。驻留集越小，并发度越高但缺页率上升；驻留集越大，缺页率下降，但超过一定程度后收益不明显且浪费内存。', `displayName`: '驻留集', `homeSectionCode`: 'sec.memory.frame-allocation', `label`: '基础', `layer`: 'CORE', `name`: '驻留集', `nodeCode`: 'os.memory.resident_set', `nodeType`: 'CONCEPT', `__oslab_export_id`: 131});
CREATE (n:`Entity` {`chapter`: '内存管理', `courseProjection`: true, `description`: '把固定/可变分配与全局/局部置换组合成三种策略：固定分配局部置换、可变分配全局置换、可变分配局部置换，决定进程页框数是否可变以及缺页时从哪里选淘汰页。', `displayName`: '页面分配与置换策略', `homeSectionCode`: 'sec.memory.frame-allocation', `label`: '进阶', `layer`: 'CORE', `name`: '页面分配与置换策略', `nodeCode`: 'os.memory.allocation_strategy', `nodeType`: 'MECHANISM', `__oslab_export_id`: 132});
CREATE (n:`Entity` {`chapter`: '内存管理', `courseProjection`: true, `description`: '在某段时间间隔（工作集窗口 Δ）内进程实际访问的页面集合，反映进程近期很可能频繁访问的页面；驻留集不应小于工作集，否则会频繁缺页。', `displayName`: '工作集', `homeSectionCode`: 'sec.memory.thrashing-workingset', `label`: '基础', `layer`: 'CORE', `name`: '工作集', `nodeCode`: 'os.memory.working_set', `nodeType`: 'CONCEPT', `__oslab_export_id`: 133});
CREATE (n:`Entity` {`chapter`: '内存管理', `courseProjection`: true, `description`: '把磁盘文件映射到进程虚拟地址空间的一个区域，进程以访问内存的方式读写文件；多个进程映射同一文件时可共享物理内存，进程退出或关闭映射时才把改动页面写回磁盘。', `displayName`: '内存映射文件', `homeSectionCode`: 'sec.memory.mmap', `label`: '进阶', `layer`: 'CORE', `name`: '内存映射文件', `nodeCode`: 'os.memory.memory_mapped_file', `nodeType`: 'MECHANISM', `__oslab_export_id`: 134});
CREATE (n:`Entity` {`chapter`: '内存管理', `courseProjection`: true, `description`: '虚拟存储器的性能主要由缺页率决定；缺页率受页面大小、分配给进程的物理块数、页面置换算法、已修改页面的写回策略和程序局部化程度影响。', `displayName`: '虚拟存储器性能', `homeSectionCode`: 'sec.memory.performance', `label`: '基础', `layer`: 'CORE', `name`: '虚拟存储器性能', `nodeCode`: 'os.memory.virtual_performance', `nodeType`: 'CONCEPT', `__oslab_export_id`: 135});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '以硬盘为载体的存储在计算机上的信息集合，由创建者定义并具有文件名；文件包含存储空间中的数据、分类和索引信息以及访问权限信息，可长期存储并允许进程间共享访问。', `displayName`: '文件', `homeSectionCode`: 'sec.files.concept', `label`: '基础', `layer`: 'CORE', `name`: '文件', `nodeCode`: 'os.file.file', `nodeType`: 'CONCEPT', `__oslab_export_id`: 136});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '操作系统为文件保存的附加信息，又称文件元数据：名称、类型、创建者、所有者、位置、大小、保护、创建时间/最后修改时间/最后存取时间。', `displayName`: '文件属性', `homeSectionCode`: 'sec.files.concept', `label`: '基础', `layer`: 'CORE', `name`: '文件属性', `nodeCode`: 'os.file.file_attributes', `nodeType`: 'CONCEPT', `__oslab_export_id`: 137});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '为便于管理按不同准则对文件划分类型：按性质和用途（系统/用户/库文件）、按数据形式（源/目标/可执行文件）、按存取控制属性（可执行/只读/读写文件）、按组织形式和处理方式（普通/目录/特殊文件）。', `displayName`: '文件分类', `homeSectionCode`: 'sec.files.concept', `label`: '基础', `layer`: 'CORE', `name`: '文件分类', `nodeCode`: 'os.file.file_classification', `nodeType`: 'CONCEPT', `__oslab_export_id`: 138});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: 'FCB（File Control Block）是存放控制文件所需各种信息的数据结构，与文件一一对应，一个 FCB 就是一个文件目录项；包含基本信息（文件名、物理位置、逻辑/物理结构）、存取控制信息和使用信息（建立时间、修改时间等）。', `displayName`: '文件控制块', `homeSectionCode`: 'sec.files.fcb-inode', `label`: '基础', `layer`: 'CORE', `name`: '文件控制块', `nodeCode`: 'os.file.fcb', `nodeType`: 'CONCEPT', `__oslab_export_id`: 139});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '将文件名与文件描述信息分离后单独形成的数据结构（i 节点/inode）：目录项中只保留文件名和索引节点号，其余描述信息放入索引节点，从而缩小目录体积、加快目录检索；磁盘索引节点含 13 个地址项 iaddr(0)～iaddr(12)，内存索引节点另增索引节点号、状态、访问计数、逻辑设备号、链接指针。', `displayName`: '索引节点', `homeSectionCode`: 'sec.files.fcb-inode', `label`: '基础', `layer`: 'CORE', `name`: '索引节点', `nodeCode`: 'os.file.inode', `nodeType`: 'CONCEPT', `__oslab_export_id`: 140});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '操作系统以系统调用形式提供的对文件的操作：创建（分配外存空间并在目录中建目录项）、删除（删除目录项和 FCB 并回收空间）、读、写、打开、关闭。', `displayName`: '文件的基本操作', `homeSectionCode`: 'sec.files.operations', `label`: '进阶', `layer`: 'CORE', `name`: '文件的基本操作', `nodeCode`: 'os.file.operations', `nodeType`: 'MECHANISM', `__oslab_export_id`: 141});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '打开（open）：检索目录，将文件的目录项/FCB 从外存复制到内存打开文件表的一个表目，并把该表目索引号（文件描述符/句柄）返回给用户，此后对文件的访问不再使用文件名而使用文件描述符；关闭（close）：从打开文件表删除相应表目。多进程共享打开时采用系统打开文件表+每进程打开文件表的两级结构，以打开计数器记录引用次数。', `displayName`: '文件的打开与关闭', `homeSectionCode`: 'sec.files.operations', `label`: '进阶', `layer`: 'CORE', `name`: '文件的打开与关闭', `nodeCode`: 'os.file.open_close', `nodeType`: 'MECHANISM', `__oslab_export_id`: 142});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '文件系统控制用户对文件存取的保护机制：通过口令保护、加密保护和访问控制（ACL）等方式，解决对文件读、写、执行的许可问题；口令和加密防止文件被他人存取或窃取，访问控制用于控制用户对文件的访问方式。', `displayName`: '访问控制', `homeSectionCode`: 'sec.files.protection', `label`: '进阶', `layer`: 'CORE', `name`: '访问控制', `nodeCode`: 'os.file.access_control', `nodeType`: 'MECHANISM', `__oslab_export_id`: 143});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '从用户角度出发所看到的文件的组织形式，与存储介质特性无关；分为无结构文件（字符流组成的流式文件，长度以字节为单位）和有结构文件（由一个以上记录组成的记录式文件，记录分定长与变长）。', `displayName`: '文件的逻辑结构', `homeSectionCode`: 'sec.files.logical-structure', `label`: '基础', `layer`: 'CORE', `name`: '文件的逻辑结构', `nodeCode`: 'os.file.logical_structure', `nodeType`: 'CONCEPT', `__oslab_export_id`: 144});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '文件中的记录一个接一个顺序排列的有结构文件，记录可以是定长或变长；排列分串结构（与关键字无关，按存入时间先后）和顺序结构（按关键字顺序排列，定长记录可用折半查找）。批量操作效率最高，但不适合频繁增删改单个记录。', `displayName`: '顺序文件', `homeSectionCode`: 'sec.files.logical-structure', `label`: '基础', `layer`: 'CORE', `name`: '顺序文件', `nodeCode`: 'os.file.sequential_file', `nodeType`: 'CONCEPT', `__oslab_export_id`: 145});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '为解决变长记录顺序文件只能顺序查找的问题，为主文件的每个记录在索引表中设置一个索引表项（含指向记录的指针和记录长度），索引表按关键字排序、本身是定长记录的顺序文件，从而把顺序检索转变为随机检索；代价是增加了索引表的存储开销。', `displayName`: '索引文件', `homeSectionCode`: 'sec.files.logical-structure', `label`: '基础', `layer`: 'CORE', `name`: '索引文件', `nodeCode`: 'os.file.index_file', `nodeType`: 'CONCEPT', `__oslab_export_id`: 146});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '顺序文件和索引文件的结合：先将变长记录顺序文件中的所有记录分为若干组，为每组第一个记录建立索引项（含关键字和指针），组内关键字可无序、组间必须有序；查找时先查索引表找到组、再在组内顺序查找，平均查找次数约为 √N（分块查找）。', `displayName`: '索引顺序文件', `homeSectionCode`: 'sec.files.logical-structure', `label`: '基础', `layer`: 'CORE', `name`: '索引顺序文件', `nodeCode`: 'os.file.index_sequential_file', `nodeType`: 'CONCEPT', `__oslab_export_id`: 147});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '直接文件：由给定记录的键值或经散列函数转换的键值直接决定记录的物理地址，存取速度很高，但不同关键字的散列函数值可能相同，会引起冲突。', `displayName`: '散列文件', `homeSectionCode`: 'sec.files.logical-structure', `label`: '基础', `layer`: 'CORE', `name`: '散列文件', `nodeCode`: 'os.file.hash_file', `nodeType`: 'CONCEPT', `__oslab_export_id`: 148});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '文件数据在物理存储设备（磁盘）上的分布和组织方式，即文件的实现，用户不可见；回答两个问题：一是文件的分配方式（对磁盘非空闲块的管理），二是文件存储空间管理（对磁盘空闲块的管理，见 4.3 节）。常用文件分配方法有连续分配、链接分配和索引分配三种，磁盘块大小通常与内存页面大小相同，磁盘 I/O 以块为单位。', `displayName`: '文件的物理结构', `homeSectionCode`: 'sec.files.physical-structure', `label`: '基础', `layer`: 'CORE', `name`: '文件的物理结构', `nodeCode`: 'os.file.physical_structure', `nodeType`: 'CONCEPT', `__oslab_export_id`: 149});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '要求每个文件在磁盘上占有一组连续的块：目录项记录文件的起始块号和占用块数；文件长 n 块并从位置 b 开始，则占有块 b,b+1,…,b+n-1，访问第 i 块可直接访问块 b+i-1。支持顺序访问和直接访问且顺序访问速度快、磁头移动最小，但会产生外部碎片，必须事先知道文件长度、无法满足动态增长，插入删除记录需物理移动相邻记录。', `displayName`: '连续分配', `homeSectionCode`: 'sec.files.physical-structure', `label`: '进阶', `layer`: 'CORE', `name`: '连续分配', `nodeCode`: 'os.file.contiguous_allocation', `nodeType`: 'MECHANISM', `__oslab_export_id`: 150});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '离散分配方式：消除磁盘外部碎片、提高磁盘利用率，便于动态分配盘块、无须事先知道文件大小，插入删除修改方便；分为隐式链接（每盘块存指向下一盘块的指针，目录项存起始块号和结束块号指针，只支持顺序访问、指针占用空间、一个盘块损坏链条即断裂）和显式链接（FAT）两种形式。', `displayName`: '链接分配', `homeSectionCode`: 'sec.files.physical-structure', `label`: '进阶', `layer`: 'CORE', `name`: '链接分配', `nodeCode`: 'os.file.linked_allocation', `nodeType`: 'MECHANISM', `__oslab_export_id`: 151});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: 'FAT（File Allocation Table）是链接分配的显式链接形式：将用于链接文件各物理块的指针显式地存放在内存的一张链接表中，该表在整个磁盘中仅设置一张；文件目录中只记录起始块号，后续块号通过查 FAT 找到。FAT 表项与全部磁盘块一一对应，-1 表示文件的最后一块，-2 表示该块空闲，因此 FAT 还兼管磁盘空闲空间。', `displayName`: '文件分配表', `homeSectionCode`: 'sec.files.physical-structure', `label`: '进阶', `layer`: 'CORE', `name`: '文件分配表', `nodeCode`: 'os.file.fat', `nodeType`: 'MECHANISM', `__oslab_export_id`: 152});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '把每个文件的所有盘块号集中放在一起：为每个文件分配一个索引块（表），将该文件的所有盘块号都记录在索引块中，目录项指向索引块。支持直接访问（第 i 块的盘块号即索引块第 i 个条目），不会产生外部碎片，但索引块增加额外存储开销；小文件索引块利用率低，大文件需多个索引块时用链指针链接低效，可用多级索引解决。', `displayName`: '索引分配', `homeSectionCode`: 'sec.files.physical-structure', `label`: '进阶', `layer`: 'CORE', `name`: '索引分配', `nodeCode`: 'os.file.indexed_allocation', `nodeType`: 'MECHANISM', `__oslab_export_id`: 153});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '为兼顾小型、中型、大型和特大型文件，UNIX 系统在索引节点中设 13 个地址项 iaddr(0)～iaddr(12)：前 10 项为直接地址（小文件直接从索引节点获得盘块号），iaddr(10) 为一级间址、iaddr(11) 为二级间址、iaddr(12) 为三级间址；4KB 盘块、4B 地址时，直接寻址 10×4KB=40KB，一级间址 1K×4KB=4MB，二级间址 1K×1K×4KB=4GB，三级间址 1K×1K×1K×4KB=4TB。', `displayName`: '混合索引分配', `homeSectionCode`: 'sec.files.physical-structure', `label`: '进阶', `layer`: 'CORE', `name`: '混合索引分配', `nodeCode`: 'os.file.mixed_index', `nodeType`: 'MECHANISM', `__oslab_export_id`: 154});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: 'FCB 的有序集合称为文件目录，一个 FCB 就是一个文件目录项；目录包含有关文件的属性、位置和所有权等信息，在用户所需的文件名和文件之间提供映射，实现按名存取。目录管理需提高检索速度、提供访问控制信息、允许不同用户对不同文件采用相同的名字。', `displayName`: '文件目录', `homeSectionCode`: 'sec.files.dir-concept', `label`: '基础', `layer`: 'CORE', `name`: '文件目录', `nodeCode`: 'os.file.directory', `nodeType`: 'CONCEPT', `__oslab_export_id`: 155});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '文件目录的组织形式，有单级目录、两级目录、树形目录和无环图目录四种：单级目录不允许多个文件重名；两级目录分主文件目录（MFD）与用户文件目录（UFD），解决了多用户重名问题；树形目录层次清晰、便于分类与保护，是目前大多数操作系统采用的结构；无环图目录在树形基础上增加指向同一节点的有向边以支持文件共享。', `displayName`: '目录结构', `homeSectionCode`: 'sec.files.dir-structure', `label`: '基础', `layer`: 'CORE', `name`: '目录结构', `nodeCode`: 'os.file.directory_structure', `nodeType`: 'CONCEPT', `__oslab_export_id`: 156});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '在目录层次上需要执行的操作：搜索（查找文件的对应目录项）、创建文件（目录中增加目录项）、删除文件（删除相应目录项）、创建目录、删除目录（①不删除非空目录，须先删空再递归删除子目录；②可删除非空目录，目录中文件和子目录同时被删除）、移动目录、显示目录、修改目录（文件属性变化需改变相应目录项）。', `displayName`: '目录的操作', `homeSectionCode`: 'sec.files.dir-operations', `label`: '进阶', `layer`: 'CORE', `name`: '目录的操作', `nodeCode`: 'os.file.directory_operations', `nodeType`: 'MECHANISM', `__oslab_export_id`: 157});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '利用路径名找到相应目录项、进而获得查找文件磁盘块所需信息的方法，基本方法有线性列表和哈希表两种：线性列表对应线性查找，实现简单但查找费时；哈希表用文件名经哈希函数得到指向线性列表中元素的指针，查找非常迅速、插入删除也较简单，但需采取措施避免冲突。目录查询需在磁盘上反复搜索、I/O 开销大，可将当前使用的文件目录复制到内存以减少磁盘操作次数。', `displayName`: '目录实现', `homeSectionCode`: 'sec.files.dir-implementation', `label`: '进阶', `layer`: 'CORE', `name`: '目录实现', `nodeCode`: 'os.file.directory_implementation', `nodeType`: 'MECHANISM', `__oslab_export_id`: 158});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '基于索引节点的文件共享方式：将文件的物理地址和属性等信息放在索引节点中，文件目录中只设置文件名及指向相应索引节点的指针；索引节点中设链接计数 count（引用计数），表示链接到本索引节点上的用户目录项数目，count=0 时才真正删除文件。硬链接就是多个指针指向一个索引节点，只要还有一个指针指向该索引节点，文件就不能删除。', `displayName`: '硬链接', `homeSectionCode`: 'sec.files.sharing', `label`: '进阶', `layer`: 'CORE', `name`: '硬链接', `nodeCode`: 'os.file.hard_link', `nodeType`: 'MECHANISM', `__oslab_export_id`: 159});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '利用符号链实现文件共享：系统创建一个 LINK 类型的新文件 L 并写入共享用户的目录，文件 L 中只含有被链接文件 F 的路径名，类似于 Windows 的快捷方式；访问 L 时操作系统按其中记录的路径名去查询文件 F 再对其读写。只有文件主拥有指向索引节点的指针，文件主删除共享文件后不会留下悬空指针，但每次访问共享文件都可能要多次读盘，且符号链接本身的索引节点也耗费磁盘空间。', `displayName`: '符号链接（软链接）', `homeSectionCode`: 'sec.files.sharing', `label`: '进阶', `layer`: 'CORE', `name`: '符号链接（软链接）', `nodeCode`: 'os.file.symbolic_link', `nodeType`: 'MECHANISM', `__oslab_export_id`: 160});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '文件系统提供高效和便捷的磁盘访问，以允许存储、定位、提取数据；其设计有两个问题：一是定义用户接口（文件及其属性、允许的操作、目录结构组织），二是创建算法和数据结构以映射逻辑文件系统到物理外存设备。一个合理的文件系统层次结构自下而上为：I/O 控制层（设备驱动程序和中断处理程序）、基本文件系统（按物理块读写并管理内存缓冲区）、文件组织模块（逻辑块地址到物理块地址的转换，含空闲空间管理器）、逻辑文件系统（管理元数据、目录结构、FCB 与文件保护）。', `displayName`: '文件系统结构', `homeSectionCode`: 'sec.files.fs-structure', `label`: '基础', `layer`: 'CORE', `name`: '文件系统结构', `nodeCode`: 'os.file.fs_structure', `nodeType`: 'CONCEPT', `__oslab_export_id`: 161});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '文件系统在外存和内存中的组织：磁盘上多数磁盘划分为一个或多个分区，每个分区中有一个独立的文件系统，其布局含主引导记录（MBR，0 号扇区，含分区表）、引导块（分区第一块，负责启动操作系统）、超级块（文件系统所有关键信息）、i 节点区、根目录、空闲空间管理信息及文件和目录；内存中的结构包括安装表、目录结构缓存、系统打开文件表和每进程打开文件表。', `displayName`: '文件系统布局', `homeSectionCode`: 'sec.files.fs-layout', `label`: '基础', `layer`: 'CORE', `name`: '文件系统布局', `nodeCode`: 'os.file.fs_layout', `nodeType`: 'CONCEPT', `__oslab_export_id`: 162});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '文件存储设备分成许多大小相同的物理块、以块为单位交换信息，其管理实质上是对空闲块的组织和管理，包括空闲块的组织、分配与回收。主要方法有：空闲表法（连续分配、表项含起始盘块号与盘块数）、空闲链表法（空闲盘块链与空闲盘区链）、位示图法（每个盘块对应一个二进制位，0 空闲 1 已分配）、成组链接法（UNIX 采用，将空闲盘块分组，各组第一块记录下一组的空闲盘块总数和盘块号）。', `displayName`: '外存空闲空间管理', `homeSectionCode`: 'sec.files.free-space', `label`: '进阶', `layer`: 'CORE', `name`: '外存空闲空间管理', `nodeCode`: 'os.file.free_space', `nodeType`: 'MECHANISM', `__oslab_export_id`: 163});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '属于连续分配方式，与内存的动态分区分配类似：系统为外存上所有空闲区建立一张空闲表，每个空闲区对应一个空闲表项（表项序号、该空闲区第一个空闲盘块号、空闲盘块数），空闲区按起始盘块号递增排列；分配采用首次适应、最佳适应等算法，回收时考虑与前后空闲区相邻接并予以合并。优点是分配速度较高、可减少访问磁盘的 I/O 频率。', `displayName`: '空闲表法', `homeSectionCode`: 'sec.files.free-space', `label`: '进阶', `layer`: 'CORE', `name`: '空闲表法', `nodeCode`: 'os.file.free_table_list', `nodeType`: 'MECHANISM', `__oslab_export_id`: 164});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '利用二进制的一位表示磁盘中一个盘块的使用情况：0 表示空闲、1 表示已分配，一个 m×n 位的位示图可表示 m×n 个盘块。分配时顺序扫描找 0 位并按 b=n(i-1)+j 换算盘块号；回收时按 i=(b-1) DIV n+1、j=(b-1) MOD n+1 换算行号列号（本书行、列均从 1 开始编号）。优点是易找到相邻接空闲盘块且位示图小可常驻内存，但位示图大小随磁盘容量增大，常用于小型计算机。', `displayName`: '位示图法', `homeSectionCode`: 'sec.files.free-space', `label`: '进阶', `layer`: 'CORE', `name`: '位示图法', `nodeCode`: 'os.file.bitmap', `nodeType`: 'MECHANISM', `__oslab_export_id`: 165});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: 'UNIX 系统采用的空闲空间管理方法，结合空闲表法和空闲链表法的思想而克服表太长的缺点：将空闲盘块分成若干组（如 100 个盘块一组），每组的第一个盘块记录下一组的空闲盘块总数和空闲盘块号，由各组第一块链接成一条链；第一组的空闲盘块总数和盘块号保存在内存专用栈（空闲盘块号栈）中。分配时从栈顶取盘块，取到栈底块时先将该块内容（下一组空闲盘块号）读入栈；回收时将盘块号压栈，栈满 100 时把栈中 100 个盘块号存入新回收的盘块并把它作为新栈底。', `displayName`: '成组链接法', `homeSectionCode`: 'sec.files.free-space', `label`: '进阶', `layer`: 'CORE', `name`: '成组链接法', `nodeCode`: 'os.file.group_linking', `nodeType`: 'MECHANISM', `__oslab_export_id`: 166});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: 'VFS（Virtual File System）屏蔽了不同文件系统的差异和操作细节，向上为用户提供文件操作的统一调用接口（如 open() 等），采用面向对象思想抽象出通用的文件系统模型。系统抽象了四种对象类型：超级块对象（表示已安装的特定文件系统）、索引节点对象（表示一个特定的文件，与文件一一对应）、目录项对象（表示一个特定的目录项，磁盘上没有对应数据结构）、文件对象（表示一个与进程相关的已打开文件）。VFS 严格来说并不是实际的文件系统，只存在于内存中，系统启动时建立、关闭时消亡。', `displayName`: '虚拟文件系统', `homeSectionCode`: 'sec.files.vfs', `label`: '进阶', `layer`: 'CORE', `name`: '虚拟文件系统', `nodeCode`: 'os.file.vfs', `nodeType`: 'MECHANISM', `__oslab_export_id`: 167});
CREATE (n:`Entity` {`chapter`: '文件管理', `courseProjection`: true, `description`: '文件系统在进程使用之前必须先安装（挂载，Mounting）：将设备中的文件系统挂载到某个目录（安装点）后，即可通过该目录访问设备上的文件。Windows 用驱动器字母表示设备和卷，新版本也允许安装在目录树下的任意位置；UNIX 在系统启动时直接安装根文件系统，其他文件系统都要先挂载到根文件系统中的某个目录后才能访问，同一设备可有多个安装点，同一安装点同时只能挂载一个设备，用 mount 安装、umount 卸载。', `displayName`: '文件系统挂载', `homeSectionCode`: 'sec.files.mounting', `label`: '进阶', `layer`: 'CORE', `name`: '文件系统挂载', `nodeCode`: 'os.file.mounting', `nodeType`: 'MECHANISM', `__oslab_export_id`: 168});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '可以将数据输入计算机的外部设备，或可以接收计算机输出数据的外部设备；类型繁多，可从信息交换单位、传输速率、使用特性、共享属性等不同角度分类。', `displayName`: 'I/O设备', `homeSectionCode`: 'sec.io.device-basics', `label`: '基础', `layer`: 'CORE', `name`: 'I/O设备', `nodeCode`: 'os.io.device', `nodeType`: 'CONCEPT', `__oslab_export_id`: 169});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '按信息交换单位分为块设备（以数据块为单位、传输速率较高、可寻址，如磁盘）与字符设备（以字符为单位、传输速率低、不可寻址、常采用中断I/O方式）；按传输速率分为低/中/高速设备；按使用特性分为存储设备与输入/输出设备；按共享属性分为独占设备、共享设备与虚拟设备（经 SPOOLing 改造）。', `displayName`: '设备分类', `homeSectionCode`: 'sec.io.device-basics', `label`: '基础', `layer`: 'CORE', `name`: '设备分类', `nodeCode`: 'os.io.device_classification', `nodeType`: 'CONCEPT', `__oslab_export_id`: 170});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '又称 I/O 接口，是 CPU 与设备之间的接口，实现设备和计算机之间的数据交换；由设备控制器与 CPU 的接口、设备控制器与设备的接口以及 I/O 逻辑三部分组成，具有接收和识别命令、数据交换、标识和报告设备状态、地址识别、数据缓冲、差错控制六项功能。', `displayName`: '设备控制器', `homeSectionCode`: 'sec.io.device-basics', `label`: '基础', `layer`: 'CORE', `name`: '设备控制器', `nodeCode`: 'os.io.device_controller', `nodeType`: 'CONCEPT', `__oslab_export_id`: 171});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '设备控制器中可被 CPU 直接访问的寄存器，包括数据寄存器、状态寄存器、控制寄存器三类；每个端口对应一个端口地址，编址方式分为独立编址（使用专用 I/O 指令）与统一编址（内存映射 I/O，用访存指令访问）两种。', `displayName`: 'I/O端口', `homeSectionCode`: 'sec.io.device-basics', `label`: '基础', `layer`: 'CORE', `name`: 'I/O端口', `nodeCode`: 'os.io.io_port', `nodeType`: 'CONCEPT', `__oslab_export_id`: 172});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '控制设备和主机之间数据传送的方式。发展宗旨是尽量减少 CPU 对 I/O 控制的干预，共有程序直接控制、中断驱动、DMA、通道控制四种方式。', `displayName`: 'I/O控制', `homeSectionCode`: 'sec.io.control-methods', `label`: '进阶', `layer`: 'CORE', `name`: 'I/O控制', `nodeCode`: 'os.io.io_control', `nodeType`: 'MECHANISM', `__oslab_export_id`: 173});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: 'CPU 对 I/O 设备采取轮询的 I/O 方式：CPU 发出 I/O 指令启动设备后，不断循环测试设备状态（轮询），直到数据就绪再取走数据。简单易实现，但 CPU 与 I/O 设备只能串行工作，CPU 利用率很低，因为未采用中断机构、设备无法主动报告完成。', `displayName`: '程序直接控制方式', `homeSectionCode`: 'sec.io.control-methods', `label`: '进阶', `layer`: 'CORE', `name`: '程序直接控制方式', `nodeCode`: 'os.io.programmed_io', `nodeType`: 'MECHANISM', `__oslab_export_id`: 174});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '允许 I/O 设备主动打断 CPU 运行并请求服务：CPU 发出 I/O 指令后转去做其他工作，设备准备好数据后通过中断信号通知 CPU，由 CPU 取走数据。设备准备数据期间 CPU 与设备并行工作，但数据交换仍必须经过 CPU 寄存器且以字（节）为单位干预，用于块设备时效率仍低。', `displayName`: '中断驱动方式', `homeSectionCode`: 'sec.io.control-methods', `label`: '进阶', `layer`: 'CORE', `name`: '中断驱动方式', `nodeCode`: 'os.io.interrupt_driven_io', `nodeType`: 'MECHANISM', `__oslab_export_id`: 175});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '直接存储器存取方式：在 I/O 设备和内存之间开辟直接数据通路，基本传送单位为数据块，数据不经过 CPU，仅在传送开始和结束时需要 CPU 干预；DMA 控制器内设命令/状态寄存器 CR、内存地址寄存器 MAR、数据寄存器 DR、数据计数器 DC 四类寄存器。', `displayName`: 'DMA方式', `homeSectionCode`: 'sec.io.control-methods', `label`: '进阶', `layer`: 'CORE', `name`: 'DMA方式', `nodeCode`: 'os.io.dma', `nodeType`: 'MECHANISM', `__oslab_export_id`: 176});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: 'I/O 通道是一种可执行通道指令的特殊处理机：CPU 只需发送一条 I/O 指令指明通道程序位置和要访问的设备，通道即自行执行通道程序完成 I/O 任务后以中断报告。通道指令类型单一、没有自己的内存（通道程序放在主机内存中、与 CPU 共享内存）；一个通道可控制多台设备，传输块大小与内存位置由通道控制。', `displayName`: '通道控制方式', `homeSectionCode`: 'sec.io.control-methods', `label`: '进阶', `layer`: 'CORE', `name`: '通道控制方式', `nodeCode`: 'os.io.channel_io', `nodeType`: 'MECHANISM', `__oslab_export_id`: 177});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '为使 I/O 软件结构清晰、可移植而采用的层次式结构：自顶向下为用户层软件、设备独立性软件、设备驱动程序、中断处理程序四层，每层利用下层服务并向上层屏蔽实现细节，仅最低层涉及硬件具体特性。', `displayName`: 'I/O软件层次结构', `homeSectionCode`: 'sec.io.io-software', `label`: '基础', `layer`: 'CORE', `name`: 'I/O软件层次结构', `nodeCode`: 'os.io.io_software_layers', `nodeType`: 'CONCEPT', `__oslab_export_id`: 178});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '为获得设备独立性而引入的概念：应用程序用逻辑设备名请求某类设备，系统实际执行时将逻辑设备名映射为物理设备名。使用逻辑设备名的好处是增加设备分配的灵活性和易于实现 I/O 重定向。', `displayName`: '逻辑设备名', `homeSectionCode`: 'sec.io.io-software', `label`: '基础', `layer`: 'CORE', `name`: '逻辑设备名', `nodeCode`: 'os.io.logical_device_name', `nodeType`: 'CONCEPT', `__oslab_export_id`: 179});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: 'I/O 系统与高层之间的接口，按设备类型分为字符设备接口（get/put、in-control、打开/关闭）、块设备接口（隐藏磁盘二维结构、将抽象命令映射为低层操作、内存映射接口）与网络设备接口（网络套接字接口）三类。', `displayName`: '应用程序I/O接口', `homeSectionCode`: 'sec.io.application-interface', `label`: '基础', `layer`: 'CORE', `name`: '应用程序I/O接口', `nodeCode`: 'os.io.application_interface', `nodeType`: 'CONCEPT', `__oslab_export_id`: 180});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: 'I/O 接口的两种模式：阻塞 I/O 中进程调用 I/O 操作后即被阻塞直到 I/O 完成，操作简单、适合并发量小的应用；非阻塞 I/O 不阻塞进程，进程以轮询方式询问 I/O 是否完成，等待期间可做其他事情，适合并发量大的应用但会占用 CPU 时间。', `displayName`: '阻塞I/O与非阻塞I/O', `homeSectionCode`: 'sec.io.application-interface', `label`: '基础', `layer`: 'CORE', `name`: '阻塞I/O与非阻塞I/O', `nodeCode`: 'os.io.blocking_io', `nodeType`: 'CONCEPT', `__oslab_export_id`: 181});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '也称与设备无关的软件，是 I/O 系统的最高层软件，其下层是设备驱动程序；包括执行所有设备公有操作的软件：设备的分配与回收、逻辑设备名到物理设备名的映射、设备保护、缓冲管理、差错控制、提供独立于设备的大小统一的逻辑块，并向用户层提供统一的 read/write 接口。', `displayName`: '设备独立性软件', `homeSectionCode`: 'sec.io.device-ind-concept', `label`: '进阶', `layer`: 'CORE', `name`: '设备独立性软件', `nodeCode`: 'os.io.device_independent_software', `nodeType`: 'MECHANISM', `__oslab_export_id`: 182});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '利用内存中的存储空间暂存从磁盘中读出的一系列盘块的信息，以提高磁盘 I/O 速度的技术；逻辑上属于磁盘，物理上是驻留在内存中的盘块。在内存中分为两种形式：开辟一个大小固定的单独空间作缓存区，或将未利用的内存空间作为缓冲池供请求分页系统和磁盘 I/O 共享。', `displayName`: '磁盘高速缓存', `homeSectionCode`: 'sec.io.cache-buffer', `label`: '进阶', `layer`: 'CORE', `name`: '磁盘高速缓存', `nodeCode`: 'os.io.disk_cache', `nodeType`: 'MECHANISM', `__oslab_export_id`: 183});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '在设备管理子系统中，为缓和 CPU 与 I/O 设备速度不匹配的矛盾而引入的缓冲技术：通常利用内存作为缓冲区。引入缓冲区的目的有：缓和 CPU 与 I/O 设备间速度不匹配的矛盾、减少对 CPU 的中断频率、解决基本数据单元大小不匹配的问题、提高 CPU 和 I/O 设备之间的并行性。', `displayName`: '缓冲区', `homeSectionCode`: 'sec.io.cache-buffer', `label`: '进阶', `layer`: 'CORE', `name`: '缓冲区', `nodeCode`: 'os.io.buffer', `nodeType`: 'MECHANISM', `__oslab_export_id`: 184});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '每当用户进程发出一个 I/O 请求，操作系统便在内存中为之分配一个缓冲区（通常一个缓冲区大小就是一个块）。设设备输入一块数据到缓冲区的时间为 T、缓冲区数据传送到工作区的时间为 M、CPU 处理一块数据的时间为 C，且必须等缓冲区充满后才能取出数据，则平均处理一块数据的时间为 Max(C,T)+M。', `displayName`: '单缓冲', `homeSectionCode`: 'sec.io.cache-buffer', `label`: '进阶', `layer`: 'CORE', `name`: '单缓冲', `nodeCode`: 'os.io.single_buffer', `nodeType`: 'MECHANISM', `__oslab_export_id`: 185});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '为加快输入输出速度、提高设备利用率而引入的机制（也称缓冲对换）：设置两个缓冲区，设备装满缓冲区 1 后转向缓冲区 2，同时操作系统从缓冲区 1 取数据送用户进程处理，两缓冲区交替使用。此时 C 和 M 可以与 T 并行，平均处理一块数据的时间为 Max(C+M,T)。', `displayName`: '双缓冲', `homeSectionCode`: 'sec.io.cache-buffer', `label`: '进阶', `layer`: 'CORE', `name`: '双缓冲', `nodeCode`: 'os.io.double_buffer', `nodeType`: 'MECHANISM', `__oslab_export_id`: 186});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '多缓冲机制：将多个大小相等的缓冲区链接成一个循环队列，每个缓冲区中有一个链接指针指向下一个缓冲区，最后一个缓冲区指针指向第一个缓冲区；并设置 in 指针（指向第一个可输入数据的空缓冲区）和 out 指针（指向第一个可提取数据的满缓冲区），输入/输出时两指针沿链接方向循环移动。', `displayName`: '循环缓冲', `homeSectionCode`: 'sec.io.cache-buffer', `label`: '进阶', `layer`: 'CORE', `name`: '循环缓冲', `nodeCode`: 'os.io.circular_buffer', `nodeType`: 'MECHANISM', `__oslab_export_id`: 187});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '包含一个用于管理自身的数据结构和一组操作函数的管理机制，用于管理多个缓冲区，可供多个进程共享使用。缓冲池由多个系统公用的缓冲区组成，按使用状况分为空缓冲队列、输入队列、输出队列三类，并设收容输入（hin）、提取输入（sin）、收容输出（hout）、提取输出（sout）四种工作缓冲区。', `displayName`: '缓冲池', `homeSectionCode`: 'sec.io.cache-buffer', `label`: '进阶', `layer`: 'CORE', `name`: '缓冲池', `nodeCode`: 'os.io.buffer_pool', `nodeType`: 'MECHANISM', `__oslab_export_id`: 188});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '根据用户的 I/O 请求分配所需的设备。分配总原则是充分发挥设备的使用效率、尽可能地让设备忙碌，又要避免由于不合理的分配方法造成进程死锁。分配需考虑设备的固有属性（独占/共享/虚拟）、设备分配算法（FCFS 或最高优先级优先）和设备分配中的安全性（安全/不安全分配方式）；分配步骤为依次分配设备、控制器、通道。', `displayName`: '设备分配与回收', `homeSectionCode`: 'sec.io.device-allocation', `label`: '进阶', `layer`: 'CORE', `name`: '设备分配与回收', `nodeCode`: 'os.io.device_allocation', `nodeType`: 'MECHANISM', `__oslab_export_id`: 189});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '用于描述系统中设备、控制器、通道从属关系的数据结构，包括：设备控制表 DCT（每设备一张，含设备类型、设备标识符、设备状态、指向控制器表的指针、重复执行次数或时间、设备队列队首指针）、控制器控制表 COCT（每控制器一张）、通道控制表 CHCT（每通道一张）以及系统设备表 SDT（整个系统只有一张）。', `displayName`: '设备分配的数据结构', `homeSectionCode`: 'sec.io.device-allocation', `label`: '基础', `layer`: 'CORE', `name`: '设备分配的数据结构', `nodeCode`: 'os.io.device_control_tables', `nodeType`: 'CONCEPT', `__oslab_export_id`: 190});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '用于将逻辑设备名映射为物理设备名的表（Logical Unit Table，LUT），每个表项包含逻辑设备名、物理设备名和设备驱动程序入口地址三项内容。有两种设置方式：整个系统只设置一张 LUT（要求所有用户不能使用相同的逻辑设备名，适用于单用户系统），或为每个用户设置一张 LUT（不同用户可以使用相同的逻辑设备名）。', `displayName`: '逻辑设备表', `homeSectionCode`: 'sec.io.device-allocation', `label`: '基础', `layer`: 'CORE', `name`: '逻辑设备表', `nodeCode`: 'os.io.lut', `nodeType`: 'CONCEPT', `__oslab_export_id`: 191});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '假脱机技术：为缓和 CPU 的高速性与 I/O 设备的低速性之间的矛盾，利用多道程序技术模拟脱机输入/输出时的外围控制机，将独占设备改造成共享设备的技术。系统由输入井和输出井、输入缓冲区和输出缓冲区、输入进程和输出进程、井管理程序组成；是一种以空间换时间的技术。', `displayName`: 'SPOOLing技术', `homeSectionCode`: 'sec.io.spooling', `label`: '进阶', `layer`: 'CORE', `name`: 'SPOOLing技术', `nodeCode`: 'os.io.spooling', `nodeType`: 'MECHANISM', `__oslab_export_id`: 192});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: 'I/O 系统的上层与设备控制器之间的通信程序：接收上层应用发来的抽象 I/O 请求（如 read/write 命令），转换为具体要求后发送给设备控制器启动设备执行任务，反之也将设备控制器发来的信号传送给上层应用。功能包括接收命令和参数并转换为具体要求、检查 I/O 请求合法性并设置设备工作方式、发出 I/O 命令、响应设备控制器发来的中断请求。', `displayName`: '设备驱动程序', `homeSectionCode`: 'sec.io.driver', `label`: '进阶', `layer`: 'CORE', `name`: '设备驱动程序', `nodeCode`: 'os.io.device_driver', `nodeType`: 'MECHANISM', `__oslab_export_id`: 193});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '表面涂有磁性物质的物理盘片，通过磁头从磁盘存取数据；盘面上的数据存储在同心圆组成的磁道上，磁道又划分为若干扇区（一个扇区称为一个盘块），多个盘片垂直堆叠组成磁盘组，所有盘片上相对位置相同的磁道组成柱面。磁盘地址用“柱面号·盘面号·扇区号”表示，扇区是磁盘可寻址的最小单位。', `displayName`: '磁盘', `homeSectionCode`: 'sec.io.disk-basics', `label`: '基础', `layer`: 'CORE', `name`: '磁盘', `nodeCode`: 'os.io.disk', `nodeType`: 'CONCEPT', `__oslab_export_id`: 194});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '磁盘投入使用前和使用中的管理过程：低级格式化（物理格式化）划分扇区、分区（每个分区由一个或多个柱面组成，起始扇区和大小记录在磁盘主引导记录的分区表中）、逻辑格式化（高级格式化，建立初始文件系统数据结构，将多个相邻扇区组合成簇）、引导块（MBR 位于磁盘第 0 号扇区）以及坏块处理（扇区备用等方式使系统不使用坏块）。', `displayName`: '磁盘管理', `homeSectionCode`: 'sec.io.disk-management', `label`: '进阶', `layer`: 'CORE', `name`: '磁盘管理', `nodeCode`: 'os.io.disk_management', `nodeType`: 'MECHANISM', `__oslab_export_id`: 195});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '一次磁盘读/写操作的时间由三部分决定：寻道时间 Ts=m×n+s（m 为与磁盘驱动器速度有关的常数约 0.2ms，n 为跨越的磁道数，s 为启动磁头臂时间约 2ms）、旋转延迟时间 Tr=1/(2r)（r 为磁盘每秒转数，5400 转/分时约 5.55ms）、传输时间 Tt=b/(rN)（b 为每次读/写的字节数，N 为一个磁道上的字节数）。总平均存取时间 Ta=Ts+Tr+Tt，其中寻道时间占大头，与磁盘调度算法密切相关。', `displayName`: '磁盘存取时间', `homeSectionCode`: 'sec.io.disk-algorithms', `label`: '基础', `layer`: 'CORE', `name`: '磁盘存取时间', `nodeCode`: 'os.io.disk_access_time', `nodeType`: 'CONCEPT', `__oslab_export_id`: 196});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '对 SCAN 和 C-SCAN 的改进：磁头只需移动到最远端的一个请求即可返回，不需要到达磁盘端点，因为它们在朝一个给定方向移动前会查看（Look）是否有请求。若无特别说明，可默认 SCAN 和 C-SCAN 算法为 LOOK 调度和 C-LOOK 调度。', `displayName`: 'LOOK与C-LOOK调度算法', `homeSectionCode`: 'sec.io.disk-algorithms', `label`: '进阶', `layer`: 'CORE', `name`: 'LOOK与C-LOOK调度算法', `nodeCode`: 'os.io.look_scheduling', `nodeType`: 'ALGORITHM', `__oslab_export_id`: 197});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '针对旋转延迟时间的优化：①对盘面的扇区进行交替编号，让逻辑上相邻的块物理上保持一定间隔，读入多个连续块时减少延迟时间；②对不同盘面进行错位命名，使读入相邻两个盘面的连续块时也能减少延迟时间。寻道时间和延迟时间属于“找”的时间，可以通过一定方法优化，传输时间由磁盘本身性质决定，不能通过措施减少。', `displayName`: '减少延迟时间的方法', `homeSectionCode`: 'sec.io.disk-algorithms', `label`: '进阶', `layer`: 'CORE', `name`: '减少延迟时间的方法', `nodeCode`: 'os.io.disk_latency_reduction', `nodeType`: 'MECHANISM', `__oslab_export_id`: 198});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '提高磁盘 I/O 速度的 7 种方法：①采用磁盘高速缓存；②调整磁盘请求顺序（磁盘调度算法）；③提前读（读当前块时将下一磁盘块也读入内存缓冲区）；④延迟写（仅在缓冲区首部设置延迟写标志，待其他进程申请到该缓冲区时才真正写盘）；⑤优化物理块的分布（同一文件的盘块安排在一条磁道或相邻磁道上、若干盘块组成簇）；⑥虚拟盘（用内存空间仿真磁盘，又称 RAM 盘）；⑦采用磁盘阵列 RAID（并行交叉存取）。', `displayName`: '提高磁盘I/O速度的方法', `homeSectionCode`: 'sec.io.disk-algorithms', `label`: '进阶', `layer`: 'CORE', `name`: '提高磁盘I/O速度的方法', `nodeCode`: 'os.io.disk_io_speedup', `nodeType`: 'MECHANISM', `__oslab_export_id`: 199});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '基于闪存技术的存储器（Solid State Disk，SSD），由一个或多个闪存芯片和闪存翻译层组成；闪存芯片替代传统磁盘中的机械驱动器，闪存翻译层将来自 CPU 的逻辑块读/写请求翻译成对底层物理设备的读/写控制信号，相当于扮演磁盘控制器的角色。一个闪存由 B 块组成、每块由 P 页组成，数据以页为单位读/写，只有一页所属的块整个被擦除后才能写这一页；随机写很慢。没有移动部件，随机访问速度快、能耗低、抗震性好。', `displayName`: '固态硬盘', `homeSectionCode`: 'sec.io.ssd', `label`: '基础', `layer`: 'CORE', `name`: '固态硬盘', `nodeCode`: 'os.io.ssd', `nodeType`: 'CONCEPT', `__oslab_export_id`: 200});
CREATE (n:`Entity` {`chapter`: '输入／输出（I/O）管理', `courseProjection`: true, `description`: '为弥补 SSD 闪存擦写寿命有限（几百次到几千次）的缺陷而引入的技术，使各闪存块的寿命损耗趋于均衡，分为两种：动态磨损均衡——写入数据时自动选择较新的闪存块，让老的闪存块先“歇一歇”；静态磨损均衡——即使没有数据写入，SSD 也监测并自动进行数据分配，让老的闪存块承担无须写数据的存储任务，读/写操作在较新的闪存块中进行。', `displayName`: '磨损均衡', `homeSectionCode`: 'sec.io.ssd', `label`: '进阶', `layer`: 'CORE', `name`: '磨损均衡', `nodeCode`: 'os.io.wear_leveling', `nodeType`: 'MECHANISM', `__oslab_export_id`: 201});
CREATE (n:`Entity` {`chapter`: '硬件管理', `description`: '启动加载程序，负责初始化硬件设备，并将操作系统内核加载到内存中运行。在实验中，bootloader分为两个阶段：stage1和stage2。', `label`: '概念', `name`: 'bootloader', `__oslab_export_id`: 260});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '对计算机内存资源进行分配、回收和保护的综合过程，包括虚拟和物理内存管理。', `label`: '概念', `name`: '内存管理', `__oslab_export_id`: 263});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '内存管理单元，硬件设备，负责虚拟地址到物理地址的映射及内存访问权限检查。', `label`: '概念', `name`: 'MMU', `__oslab_export_id`: 264});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '处理器通过地址访问内存数据的过程，涉及地址转换、内存保护和缓存命中等环节。', `label`: '概念', `name`: '内存访问', `__oslab_export_id`: 265});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: 'MIPS架构的虚拟地址空间划分，包括用户空间、内核空间等不同区域，各有不同用途。', `label`: '算法', `name`: 'MIPS 虚存映射布局', `__oslab_export_id`: 266});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '对物理内存的分配和回收进行管理，通过数据结构（如空闲链表）记录页面使用情况。', `label`: '算法', `name`: '物理内存管理', `__oslab_export_id`: 267});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '记录物理页面信息（如状态、引用次数等）的数据结构，常以链表形式管理。', `label`: '功能', `name`: '内存控制块', `__oslab_export_id`: 268});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '通过虚拟地址空间和物理地址空间的映射，为程序提供独立内存空间的技术。', `label`: '算法', `name`: '虚拟内存管理', `__oslab_export_id`: 269});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '一种虚拟内存管理机制，通过页目录和页表两级索引将虚拟地址映射到物理地址。', `label`: '算法', `name`: '两级页表机制', `__oslab_export_id`: 270});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '将虚拟地址转换为物理地址的过程，通过查询页目录和页表完成。', `label`: '算法', `name`: '地址转换', `__oslab_export_id`: 271});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '虚拟内存管理的基本单位，表示虚拟地址空间中的一个固定大小区域。', `label`: '概念', `name`: '页', `__oslab_export_id`: 272});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '页目录通过页表项映射到虚拟地址空间，减少页表存储空间需求的技术。', `label`: '算法', `name`: '页目录自映射', `__oslab_export_id`: 273});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '将虚拟地址转换为物理地址的过程，主要由MMU完成。', `label`: '算法', `name`: '内存翻译', `__oslab_export_id`: 274});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '操作系统中一个独立的执行单元，拥有自己的地址空间、代码段、数据段和堆栈。进程是程序的运行实例，由操作系统管理和调度。', `label`: '概念', `name`: '进程', `__oslab_export_id`: 275});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `label`: '概念', `name`: '系统调用', `__oslab_export_id`: 277});
CREATE (n:`Entity` {`chapter`: '进程管理', `label`: '概念', `name`: '进程创建', `__oslab_export_id`: 282});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '操作系统中的一种运行模式，用户程序运行在这种模式下，只能执行非特权指令，访问受限的资源。用户态程序需要通过系统调用请求内核服务。', `label`: '概念', `name`: '用户态', `__oslab_export_id`: 286});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '操作系统中的一种运行模式，内核程序运行在这种模式下，可以执行特权指令，访问所有系统资源。用户态程序通过系统调用进入内核态。', `label`: '概念', `name`: '内核态', `__oslab_export_id`: 287});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '用于存储进程环境信息的数据结构，可能包含进程的标识符、状态、优先级、地址空间等信息。在实验中，Env结构体可能用于管理进程的运行环境。', `label`: '功能', `name`: 'Env 结构体', `__oslab_export_id`: 288});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '一个存储所有进程控制块（PCB）的数组。每个PCB记录了一个进程的状态、上下文信息、地址空间等。在实验中，需要为这个数组分配内存，并将其映射到内核地址空间。', `label`: '算法', `name`: '进程控制块数组', `__oslab_export_id`: 289});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '指进程在处理器上执行的过程。进程运行时，操作系统会分配CPU时间给进程，并恢复进程的上下文环境，使其从上次停止的地方继续执行。在实验中，进程运行涉及到保存和恢复进程上下文，以及切换到进程的地址空间。', `label`: '算法', `name`: '进程运行', `__oslab_export_id`: 290});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '当前运行的进程被挂起，操作系统切换到另一个进程运行的过程。在实验中，进程切换涉及到保存当前进程的上下文、恢复下一个进程的上下文，并更新CPU的执行状态。', `label`: '算法', `name`: '进程切换', `__oslab_export_id`: 291});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '程序运行时发生的一种非正常事件，导致控制流的改变。异常可以是同步的（如指令错误）或异步的（如中断）。', `label`: '概念', `name`: '异常', `__oslab_export_id`: 292});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '一种异步事件，由硬件设备（如定时器、I/O设备）或软件（如系统调用）触发，导致CPU暂停当前程序，执行中断处理程序。', `label`: '概念', `name`: '中断', `__oslab_export_id`: 293});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '当发生异常时，处理器执行的一个过程，用于根据异常码找到对应的异常处理函数。在实验中，异常分发代码会从异常向量组中获取处理函数地址。', `label`: '算法', `name`: '异常分发', `__oslab_export_id`: 294});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '由系统时钟产生的中断，用于实现时间片轮转调度。在实验中，时钟中断触发时，当前运行的进程被挂起，操作系统进行进程调度。', `label`: '算法', `name`: '时钟中断', `__oslab_export_id`: 295});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '操作系统根据一定的算法（如时间片轮转算法）决定哪个进程应该获得CPU时间的过程。在实验中，通过时钟中断触发进程调度，调度函数会选择一个就绪状态的进程运行，并将当前进程挂起。', `label`: '算法', `name`: '进程调度', `__oslab_export_id`: 296});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '操作系统提供的一种机制，允许用户空间的程序通过特定的指令（如syscall）进入内核态，请求操作系统的服务。', `label`: '算法', `name`: '系统调用机制', `__oslab_export_id`: 298});
CREATE (n:`Entity` {`description`: '可能是实验中定义的一个系统调用函数，用于实现特定的系统调用功能。', `label`: '功能', `name`: 'msyscall 函数', `__oslab_export_id`: 299});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '实现基本系统调用功能的函数，如内存分配、进程创建等。', `label`: '功能', `name`: '基础系统调用函数', `__oslab_export_id`: 300});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '允许不同进程之间交换数据或协同工作的机制，如消息传递、共享内存等。', `label`: '概念', `name`: '进程间通信机制', `__oslab_export_id`: 301});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '一个系统调用，用于创建一个新进程（子进程），子进程是父进程的副本，拥有几乎相同的运行状态和资源。', `label`: '概念', `name`: 'fork 函数', `__oslab_export_id`: 302});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '一种内存管理技术，多个进程共享同一物理页面，当某个进程尝试写入该页面时，系统会复制该页面，为写入进程创建一个独立的副本。', `label`: '算法', `name`: '写时复制机制', `__oslab_export_id`: 303});
CREATE (n:`Entity` {`chapter`: '操作系统概述', `description`: '操作系统的核心部分，负责管理系统的硬件资源和软件资源，提供系统调用接口。', `label`: '概念', `name`: '内核', `__oslab_export_id`: 305});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '用于组织、存储和管理计算机数据的系统，提供文件和目录的抽象概念。', `label`: '功能', `name`: '文件系统', `__oslab_export_id`: 306});
CREATE (n:`Entity` {`chapter`: '操作系统概述', `description`: '一种操作系统设计，将大部分功能（如文件系统、设备驱动等）移到用户空间，内核只保留基本功能。', `label`: '功能', `name`: '微内核', `__oslab_export_id`: 307});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '一种文件系统，使用磁盘作为存储介质，管理磁盘上的文件和目录。', `label`: '功能', `name`: '磁盘文件系统', `__oslab_export_id`: 308});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '在用户空间中实现的文件系统，通过系统调用或通用机制为其他用户程序提供文件服务。', `label`: '功能', `name`: '用户空间文件系统', `__oslab_export_id`: 309});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '将一个地址空间（如虚拟地址）映射到另一个地址空间（如物理地址）的过程。', `label`: '算法', `name`: '地址映射', `__oslab_export_id`: 310});
CREATE (n:`Entity` {`chapter`: '硬件管理', `description`: '处理器中的存储单元，用于存储指令执行过程中的临时数据和状态信息。', `label`: '概念', `name`: '寄存器', `__oslab_export_id`: 311});
CREATE (n:`Entity` {`chapter`: '硬件管理', `description`: '外部设备的寄存器，用于控制和访问设备的硬件资源。', `label`: '概念', `name`: '外设寄存器', `__oslab_export_id`: 312});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '用于操作IDE磁盘的驱动程序，实现对IDE磁盘的读写控制。', `label`: '算法', `name`: 'IDE 磁盘驱动', `__oslab_export_id`: 313});
CREATE (n:`Entity` {`chapter`: '硬件管理', `description`: '将设备的寄存器映射到内存地址空间，通过内存读写指令访问设备寄存器，实现设备控制。', `label`: '算法', `name`: '内存映射 I/O 技术', `__oslab_export_id`: 314});
CREATE (n:`Entity` {`chapter`: '硬件管理', `description`: '输入/输出操作，指程序与外部设备（如磁盘、键盘、显示器等）之间的数据传输。', `label`: '算法', `name`: 'I/O操作', `__oslab_export_id`: 315});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '一种硬盘接口标准，全称为“Integrated Drive Electronics”，常用于连接硬盘和光驱。', `label`: '概念', `name`: 'IDE 磁盘', `__oslab_export_id`: 316});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '文件系统的设计和实现，包括文件、目录、磁盘块等的组织和管理方式。', `label`: '算法', `name`: '文件系统结构', `__oslab_export_id`: 317});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '提供给用户程序的接口，用于访问文件系统服务，如打开、读写、关闭文件等。', `label`: '功能', `name`: '文件系统用户接口', `__oslab_export_id`: 318});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '提供文件系统功能的服务，如文件的创建、删除、读写等，通常以用户态进程形式运行。', `label`: '功能', `name`: '文件系统服务', `__oslab_export_id`: 319});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '一种进程间通信机制，允许一个进程（写端）向另一个进程（读端）发送数据。在实验中，管道用于父子进程之间的单向通信。', `label`: '概念', `name`: '管道', `__oslab_export_id`: 320});
CREATE (n:`Entity` {`description`: '操作系统提供的命令行接口，用户可以通过输入命令来执行各种操作。在实验中，shell命令用于测试管道和进程间通信的功能。', `label`: '功能', `name`: 'shell命令', `__oslab_export_id`: 322});
CREATE (n:`Entity` {`chapter`: '硬件管理', `description`: '计算机的物理设备，包括CPU、内存、硬盘、显卡等。硬件为操作系统和应用程序提供运行的基础。', `label`: '概念', `name`: '硬件', `__oslab_export_id`: 323});
CREATE (n:`Entity` {`chapter`: '操作系统概述', `description`: '运行在硬件上的程序，包括操作系统、应用程序和库等。软件为用户提供各种功能和服务。', `label`: '概念', `name`: '软件', `__oslab_export_id`: 324});
CREATE (n:`Entity` {`chapter`: '硬件管理', `description`: '一个用于模拟计算机硬件环境的软件工具，用于测试和调试操作系统。在实验中，gxemul用于运行操作系统内核。', `label`: '概念', `name`: 'gxemul 仿真器', `__oslab_export_id`: 325});
CREATE (n:`Entity` {`chapter`: '硬件管理', `description`: 'bootloader的第一阶段，主要负责初始化基本硬件设备，并为加载stage2做准备。stage1通常运行在受限的环境中，功能较为简单。', `label`: '概念', `name`: 'stage1', `__oslab_export_id`: 329});
CREATE (n:`Entity` {`chapter`: '硬件管理', `description`: 'bootloader的第二阶段，负责将操作系统内核从存储设备加载到内存中，并跳转到内核入口点运行。', `label`: '概念', `name`: 'stage2', `__oslab_export_id`: 330});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '虚拟地址空间的划分和组织方式，包括用户空间、内核空间等不同区域。', `label`: '算法', `name`: '内存映射布局', `__oslab_export_id`: 338});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '管理空闲物理页面的数据结构，便于快速分配和回收物理页面。', `label`: '算法', `name`: '空闲链表', `__oslab_export_id`: 339});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '将虚拟地址空间划分为固定大小的页面，通过页表映射到物理内存页面，提供独立虚拟地址空间。', `label`: '算法', `name`: '分页式虚存管理', `__oslab_export_id`: 340});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '用于从系统中分配指定大小的物理内存或虚拟内存的函数。在物理内存管理中，内存分配函数会从空闲链表中分配页面，并更新相关的数据结构（如内存控制块）。在虚拟内存管理中，内存分配函数还需要设置页表项以建立虚拟地址到物理地址的映射。', `label`: '算法', `name`: '内存分配函数', `__oslab_export_id`: 341});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '将已分配的物理页面返回到空闲链表的函数，用于管理物理内存的释放。', `label`: '算法', `name`: '内存释放函数', `__oslab_export_id`: 342});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '翻译后备缓冲区，MMU中的高速缓存，存储最近使用的地址映射关系，提高转换效率。', `label`: '概念', `name`: 'TLB', `__oslab_export_id`: 343});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '存储虚拟地址到物理地址映射关系的数据结构，用于分页式虚拟内存管理。', `label`: '概念', `name`: '页表', `__oslab_export_id`: 344});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '高速缓存，存储最近访问的内存数据副本，减少处理器访问内存的时间，提高性能。', `label`: '概念', `name`: 'cache', `__oslab_export_id`: 345});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: 'MIPS用户模式下的虚拟地址空间，需通过MMU进行虚拟地址到物理地址的转换。', `label`: '功能', `name`: 'kuseg 区域', `__oslab_export_id`: 346});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: 'MIPS内核地址空间，用于访问物理内存低端部分，无需MMU转换。', `label`: '功能', `name`: 'kseg0 区域', `__oslab_export_id`: 347});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: 'MIPS内核地址空间，用于访问物理内存低端部分，无需MMU转换。', `label`: '功能', `name`: 'kseg1 区域', `__oslab_export_id`: 348});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: 'MIPS内核地址空间，用于访问物理内存高端部分，无需MMU转换。', `label`: '功能', `name`: 'kseg2 区域', `__oslab_export_id`: 349});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '用于记录物理页面信息（如引用次数、状态等），常以链表形式管理空闲和已分配页面。', `label`: '功能', `name`: 'Page 结构体', `__oslab_export_id`: 350});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '为虚拟地址空间分配页目录和页表，并初始化页表项的过程。', `label`: '算法', `name`: '创建页表', `__oslab_export_id`: 351});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '当TLB中无虚拟地址映射时，从页表加载映射关系到TLB的过程。', `label`: '算法', `name`: 'TLB 重填', `__oslab_export_id`: 352});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '两级页表机制中的第一级表，包含页目录项，每个项指向一个页表。', `label`: '功能', `name`: '页目录', `__oslab_export_id`: 353});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '程序运行时使用的地址，由操作系统管理并通过MMU映射到物理地址。', `label`: '概念', `name`: '虚拟地址', `__oslab_export_id`: 354});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '内存模块中的实际地址，表示物理内存中的位置，由MMU从虚拟地址转换而来。', `label`: '概念', `name`: '物理地址', `__oslab_export_id`: 355});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '用于记录进程状态和信息的数据结构，包括进程的上下文、状态、优先级等。', `label`: '概念', `name`: '进程控制块', `__oslab_export_id`: 357});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '进程可以访问的内存区域，包括代码段、数据段、堆栈等。每个进程都有独立的地址空间，由操作系统通过页表等机制进行管理。', `label`: '概念', `name`: '地址空间', `__oslab_export_id`: 358});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '进程地址空间中存储程序代码的区域。代码段在程序加载时被初始化，并在进程运行时被CPU执行。', `label`: '概念', `name`: '代码段', `__oslab_export_id`: 359});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '进程地址空间中用于存储程序数据（如变量、数组等）的区域。数据段在进程运行时被初始化，并可以动态扩展。', `label`: '概念', `name`: '数据段', `__oslab_export_id`: 360});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '进程地址空间中用于存储临时数据和函数调用信息的区域。堆栈在函数调用、中断处理和异常处理中起重要作用。', `label`: '概念', `name`: '堆栈', `__oslab_export_id`: 361});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '用于唯一标识一个进程的编号或标签。在实验中，每个进程控制块（PCB）都有一个唯一的标识符，操作系统通过这个标识符来管理进程。', `label`: '概念', `name`: '进程标识', `__oslab_export_id`: 363});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '在用户空间中运行的进程，只能访问用户空间的资源，不能直接访问内核空间。', `label`: '概念', `name`: '用户进程', `__oslab_export_id`: 365});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '用户程序运行的地址空间，用户程序只能访问用户空间中的资源，不能直接访问内核空间。', `label`: '概念', `name`: '用户空间', `__oslab_export_id`: 367});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '内核程序运行的地址空间，内核可以直接访问内核空间中的资源。', `label`: '概念', `name`: '内核空间', `__oslab_export_id`: 368});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '用于保存中断或异常发生时的上下文信息的数据结构。它包含了寄存器的值、程序计数器等信息，用于在中断处理完成后恢复程序的执行。', `label`: '功能', `name`: 'Trapframe 结构体', `__oslab_export_id`: 370});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '进程运行时的环境状态，包括寄存器的值、程序计数器（PC）、栈指针等信息。在进程切换时，需要保存当前进程的上下文，并恢复下一个进程的上下文。', `label`: '算法', `name`: '进程上下文', `__oslab_export_id`: 371});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '一个数组，存储了不同异常对应的处理函数的地址。当发生异常时，处理器根据异常码从异常向量组中找到对应的处理函数并执行。', `label`: '算法', `name`: '异常向量组', `__oslab_export_id`: 372});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '当发生异常时，处理器生成的一个代码，用于标识异常的类型。在实验中，异常码用于确定调用哪个异常处理函数。', `label`: '算法', `name`: '异常码', `__oslab_export_id`: 373});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '当发生中断时，操作系统调用的函数，用于处理中断事件。在实验中，中断处理函数会根据中断类型执行相应的操作，如进程调度或设备服务。', `label`: '算法', `name`: '中断处理函数', `__oslab_export_id`: 374});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '一个硬件设备，用于生成时钟中断。在实验中，定时器被配置为每隔一定时间产生一个中断，用于实现时间片轮转调度。', `label`: '算法', `name`: '定时器', `__oslab_export_id`: 375});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '一种进程调度算法，将CPU时间划分为固定大小的时间片，每个进程轮流获得一个时间片运行。如果进程在时间片结束时仍未完成，则被挂起，等待下一轮调度。', `label`: '算法', `name`: '时间片轮转算法', `__oslab_export_id`: 376});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '在内核空间中运行的函数，通常用于实现系统调用的具体功能，或处理内核相关的任务。', `label`: '算法', `name`: '内核函数', `__oslab_export_id`: 377});
CREATE (n:`Entity` {`chapter`: '硬件管理', `description`: '指计算机的硬件组成和架构，包括处理器、内存、I/O设备等。', `label`: '概念', `name`: '硬件结构', `__oslab_export_id`: 378});
CREATE (n:`Entity` {`chapter`: '操作系统概述', `description`: '在用户空间中实现的库函数，封装了系统调用或其他底层操作，方便用户程序使用。', `label`: '功能', `name`: '标准库函数', `__oslab_export_id`: 379});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '用于触发系统调用的指令，用户程序通过执行该指令进入内核态。', `label`: '算法', `name`: 'syscall 指令', `__oslab_export_id`: 380});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '在用户空间实现的函数，封装了系统调用的细节，方便用户程序调用操作系统的服务。例如，printf函数最终会调用系统调用write来输出内容。', `label`: '功能', `name`: '系统调用函数', `__oslab_export_id`: 382});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '用于标识系统调用类型的编号，内核通过系统调用号来区分不同的系统调用请求。', `label`: '算法', `name`: '系统调用号', `__oslab_export_id`: 383});
CREATE (n:`Entity` {`description`: '函数调用时在栈上分配的一块区域，用于存储函数的局部变量、返回地址等信息。', `label`: '算法', `name`: '栈帧', `__oslab_export_id`: 384});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '只能在内核态执行的指令，用户态程序不能直接执行特权指令，以保证系统的安全性和稳定性。', `label`: '算法', `name`: '特权指令', `__oslab_export_id`: 385});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '当发生异常（如中断、非法指令等）时，操作系统或硬件采取的一系列措施，包括保存现场、查找异常处理程序、执行处理程序等。', `label`: '算法', `name`: '异常处理', `__oslab_export_id`: 386});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '在用户空间中实现的库函数，封装了系统调用或其他底层操作，方便用户程序使用。例如，标准库中的printf、malloc等函数。', `label`: '功能', `name`: '用户空间库函数', `__oslab_export_id`: 387});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '内核中实现的系统调用函数，以syscall_开头，每个函数对应一个特定的系统调用功能。', `label`: '功能', `name`: 'syscall_* 函数', `__oslab_export_id`: 388});
CREATE (n:`Entity` {`description`: '在函数调用或系统调用中，将参数从调用方传递给被调用方的过程。', `label`: '功能', `name`: '参数传递机制', `__oslab_export_id`: 389});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '系统调用函数，用于分配内存。', `label`: '功能', `name`: 'sys_mem_alloc 函数', `__oslab_export_id`: 390});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '系统调用函数，用于建立内存映射。', `label`: '功能', `name`: 'sys_mem_map 函数', `__oslab_export_id`: 391});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '系统调用函数，用于解除内存映射。', `label`: '功能', `name`: 'sys_mem_unmap 函数', `__oslab_export_id`: 392});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '系统调用函数，用于让出CPU时间，使其他进程可以运行。', `label`: '功能', `name`: 'sys_yield 函数', `__oslab_export_id`: 393});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '每个进程拥有独立的地址空间，进程之间不能直接访问彼此的地址空间，以保证系统的安全性和稳定性。', `label`: '功能', `name`: '地址空间独立性', `__oslab_export_id`: 394});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '多个进程可以共享同一块内存区域，用于进程间通信或数据共享。', `label`: '功能', `name`: '共享内存', `__oslab_export_id`: 395});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '由父进程通过fork函数创建的新进程，子进程继承了父进程的大部分资源和状态，但拥有独立的进程控制块和地址空间。', `label`: '概念', `name`: '子进程', `__oslab_export_id`: 397});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '创建子进程的进程，父进程通过fork函数创建子进程，并可以对子进程进行管理和控制。', `label`: '概念', `name`: '父进程', `__oslab_export_id`: 398});
CREATE (n:`Entity` {`chapter`: '中断与系统调用', `description`: '用于处理异常（如缺页中断）的栈，当发生异常时，系统会切换到异常处理栈上执行异常处理程序。', `label`: '算法', `name`: '异常处理栈', `__oslab_export_id`: 399});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '允许多个进程共享同一块内存区域，同时保护内存不被非法访问的机制。', `label`: '算法', `name`: '内存共享与保护机制', `__oslab_export_id`: 401});
CREATE (n:`Entity` {`chapter`: '内存管理', `description`: '当处理器访问内存时，如果TLB（Translation Lookaside Buffer）中没有找到对应的虚拟地址到物理地址的映射，则会发生TLB缺失。此时需要从页表中加载映射关系到TLB。', `label`: '算法', `name`: 'TLB 缺失', `__oslab_export_id`: 402});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '文件系统中用于存储数据的基本单位，具有文件名、属性和内容等信息。', `label`: '概念', `name`: '文件', `__oslab_export_id`: 403});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '文件系统中用于组织文件和目录的结构，以树形层次结构表示文件和目录之间的关系。', `label`: '概念', `name`: '树形目录', `__oslab_export_id`: 404});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '用于存储数据的硬件设备，如硬盘、光盘、闪存等。', `label`: '概念', `name`: '数据存储设备', `__oslab_export_id`: 405});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '用于操作外部存储设备（如磁盘、光盘等）的软件，通过读写特定寄存器实现设备的控制和数据传输。', `label`: '算法', `name`: '外部储存设备驱动', `__oslab_export_id`: 407});
CREATE (n:`Entity` {`chapter`: '操作系统概述', `description`: '一种操作系统设计，将大部分功能（如文件系统、设备驱动等）集成在内核中，与微内核相对。', `label`: '功能', `name`: '宏内核操作系统', `__oslab_export_id`: 409});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '用于存储数据的硬件设备，通过磁头读写磁盘上的数据，常见的有IDE磁盘、SATA磁盘等。', `label`: '概念', `name`: '磁盘驱动器', `__oslab_export_id`: 410});
CREATE (n:`Entity` {`description`: '在用户空间中实现的设备驱动程序，通过系统调用与内核交互，实现设备的控制和数据传输。', `label`: '功能', `name`: '用户态驱动', `__oslab_export_id`: 411});
CREATE (n:`Entity` {`chapter`: '硬件管理', `description`: '设备寄存器之一，用于控制设备的操作，如启动读写操作等。', `label`: '概念', `name`: '控制寄存器', `__oslab_export_id`: 412});
CREATE (n:`Entity` {`chapter`: '硬件管理', `description`: '设备寄存器之一，用于存储设备的状态信息，如是否准备好、是否有错误等。', `label`: '概念', `name`: '状态寄存器', `__oslab_export_id`: 413});
CREATE (n:`Entity` {`chapter`: '硬件管理', `description`: '设备寄存器之一，用于存储设备传输的数据。', `label`: '概念', `name`: '数据寄存器', `__oslab_export_id`: 414});
CREATE (n:`Entity` {`chapter`: '硬件管理', `description`: '用于控制串口设备的驱动程序，实现串口设备的数据传输和控制。', `label`: '算法', `name`: '串口通信驱动程序', `__oslab_export_id`: 415});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '磁盘的基本读写单位，通常是512字节或4096字节，磁盘被划分为多个扇区。', `label`: '概念', `name`: '扇区', `__oslab_export_id`: 417});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '磁盘上以盘片中心为圆心的同心圆，磁头在磁道上移动以读写数据。', `label`: '概念', `name`: '磁道', `__oslab_export_id`: 418});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '硬盘中不同盘片相同半径的磁道组成的圆柱，柱面是磁盘的一个逻辑结构。', `label`: '概念', `name`: '柱面', `__oslab_export_id`: 419});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '磁盘驱动器中用于读写磁盘数据的部件，每个磁盘面都有一个磁头，磁头在盘片上移动以访问数据。', `label`: '概念', `name`: '磁头', `__oslab_export_id`: 420});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '文件系统中的一个数据结构，用于存储文件系统的基本信息，如磁盘大小、根目录位置等。', `label`: '算法', `name`: '超级块', `__oslab_export_id`: 421});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '一种数据结构，用于记录磁盘中空闲块的使用情况，每个位表示一个磁盘块是否被占用。', `label`: '算法', `name`: '空闲块位图', `__oslab_export_id`: 422});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '用于描述和管理文件的数据结构，包含文件的属性、数据块指针等信息。', `label`: '算法', `name`: '文件控制块', `__oslab_export_id`: 423});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '借助虚拟内存实现磁盘块缓存的设计，将磁盘块映射到进程的虚拟内存空间，提高磁盘读写效率。', `label`: '算法', `name`: '块缓存', `__oslab_export_id`: 424});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '允许不同进程之间交换数据或协同工作的机制，常见的有管道、共享内存、消息队列等。在实验中，主要使用管道作为进程间通信的方式。', `label`: '概念', `name`: '进程间通信方式', `__oslab_export_id`: 426});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '数据只能在一个方向上流动的通信方式，如管道就是一种单向通信机制，数据只能从写端流向读端。', `label`: '概念', `name`: '单向通信', `__oslab_export_id`: 445});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '一种只能在具有亲缘关系的进程（如父子进程）之间使用的管道，管道的两端是匿名的，不能被其他进程访问。', `label`: '算法', `name`: '匿名管道', `__oslab_export_id`: 446});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '用于标识打开文件的整数，操作系统通过文件描述符管理文件的打开、读写和关闭操作。', `label`: '概念', `name`: '文件描述符', `__oslab_export_id`: 448});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '父进程和子进程之间通过某种机制交换数据或协同工作的过程。在实验中，父子进程通信主要通过管道实现。', `label`: '概念', `name`: '父子进程通信', `__oslab_export_id`: 449});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '用于实现管道的数据结构，包含管道的读写指针、缓冲区等信息。在实验中，Pipe结构体用于管理管道的读写操作。', `label`: '算法', `name`: 'Pipe 结构体', `__oslab_export_id`: 450});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '从管道中读取数据的操作，通常由子进程执行。管道读取时，数据从管道的缓冲区中读出。', `label`: '算法', `name`: '管道读取', `__oslab_export_id`: 451});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '将数据写入管道的操作，通常由父进程执行。管道写入时，数据被写入管道的缓冲区，供子进程读取。', `label`: '算法', `name`: '管道写入', `__oslab_export_id`: 452});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '多个进程同时访问管道时可能出现的竞争条件，导致数据读写不一致或错误。在实验中，需要通过同步机制解决管道竞争问题。', `label`: '算法', `name`: '管道竞争', `__oslab_export_id`: 453});
CREATE (n:`Entity` {`chapter`: '进程管理', `description`: '通过某种机制确保管道的读写操作是安全的，避免竞争条件和数据不一致的问题。在实验中，管道同步通过控制读写指针的更新和检查管道状态实现。', `label`: '算法', `name`: '管道同步', `__oslab_export_id`: 454});
CREATE (n:`Entity` {`chapter`: '文件系统', `description`: '用于改变命令的标准输入或标准输出的符号，如>（输出重定向）和<（输入重定向）。在实验中，重定向符号用于将文件内容作为命令的输入或输出。', `label`: '功能', `name`: '重定向符号', `__oslab_export_id`: 456});
CREATE (n:`Entity` {`description`: '用于连接两个命令的符号，如`', `label`: '功能', `name`: '管道符号', `__oslab_export_id`: 457});
CREATE (n:`Entity` {`chapter`: '操作系统概述', `description`: '管理计算机硬件资源和软件资源的系统软件，提供用户与硬件之间的接口。操作系统负责进程管理、内存管理、文件系统管理等功能。', `label`: '功能', `name`: '操作系统', `__oslab_export_id`: 624});

