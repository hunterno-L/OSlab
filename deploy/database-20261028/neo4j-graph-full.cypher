CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '作业从提交到完成通常经历高级调度（作业调度）、中级调度（内存调度）和低级调度（进程调度），三者的频率、作用对象和必要性不同。', `displayName`: '三级调度', `homeSectionCode`: 'sec.process.scheduling-concept', `label`: '基础', `layer`: 'CORE', `name`: '三级调度', `nodeCode`: 'os.cpu.scheduling_level', `nodeType`: 'CONCEPT', `__oslab_export_id`: 87});
