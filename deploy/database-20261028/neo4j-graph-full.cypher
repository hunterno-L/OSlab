CREATE (n:`Entity` {`chapter`: '进程与线程', `courseProjection`: true, `description`: '线程可在用户空间由线程库实现（用户级线程），也可由内核管理（内核级线程），或采用两者结合的混合方式。', `displayName`: '线程实现方式', `homeSectionCode`: 'sec.process.thread', `label`: '进阶', `layer`: 'CORE', `name`: '线程实现方式', `nodeCode`: 'os.process.thread_implementation', `nodeType`: 'MECHANISM', `__oslab_export_id`: 85});
