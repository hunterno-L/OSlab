# Copy this file to deploy/.env before using Docker Compose. Never commit .env.
# Use long, unique values for every required password.
MYSQL_ROOT_PASSWORD=replace-with-a-long-unique-root-password
MYSQL_APP_PASSWORD=replace-with-a-long-unique-application-password
REDIS_PASSWORD=replace-with-a-long-unique-redis-password
NEO4J_PASSWORD=replace-with-a-long-unique-neo4j-password
# Shared only by backend and the private code-sandbox API. Use a separate,
# long random value; it must not be reused as a database password.
SANDBOX_AUTH_SECRET=replace-with-a-long-unique-sandbox-secret

# Migration guard for the Neo4j graph seed. Leave false for a new deployment.
# Set true only once to adopt an existing neo4j_data volume after it has been
# backed up and verified; it never imports the checked-in dump in that mode.
NEO4J_SEED_ACCEPT_EXISTING_DATA=false

# Optional: defaults to oslab_app when omitted.
# MYSQL_APP_USERNAME=oslab_app

# Optional. Leave empty to keep the AI assistant disabled.
AI_ARK_API_KEY=
AI_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_ARK_MODEL=deepseek-v3-250324

# The frontend proxies /api to the backend on the same origin, so this should
# normally remain empty. Set only exact extra browser origins, comma-separated.
CORS_ALLOWED_ORIGINS=

# Host port exposed by the frontend container. Keep 80 by default, or set e.g.
# 8080 when port 80 is already occupied on a development machine.
OSLAB_HTTP_PORT=80

# Optional Tencent COS upload configuration. Leave all four empty if file
# uploads are not needed; never put real credentials in application.yml.
COS_ACCESS_KEY=
COS_SECRET_KEY=
COS_REGION=ap-beijing
COS_BUCKET=
