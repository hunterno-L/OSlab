MATCH (n:Entity {name: item.name})
WHERE n.chapter IS NULL OR trim(n.chapter) IN ['', '未分类']
SET n.chapter = item.chapter
WITH item.chapter AS chapter, count(n) AS updated
RETURN chapter, updated ORDER BY chapter;

