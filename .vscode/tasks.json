{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "run osLab backend",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Set-Location '.\\后端代码\\osLab-backend'; .\\mvnw.cmd spring-boot:run"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "run osLab frontend",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Set-Location '.\\前端代码\\osLab-frontend'; npm run serve"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "run osLab backend cmd",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/c",
				"cd /d \".\\后端代码\\osLab-backend\" && mvnw.cmd spring-boot:run"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "run osLab frontend cmd",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/c",
				"cd /d \".\\前端代码\\osLab-frontend\" && npm run serve"
			],
			"isBackground": true,
			"group": "build"
		}
	]
}